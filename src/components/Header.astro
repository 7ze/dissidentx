---
interface Props {
  codex?: string;
  codexTitle?: string;
}

const { codex, codexTitle: customTitle } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/essays", label: "Essays" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

let codexLabel = codex;
let codexTitle = customTitle || "";

if (!codexLabel) {
  if (pathname === "/") {
    codexLabel = "CODEX 01";
    codexTitle = "Codex 01 · The Hearth";
  } else if (pathname.startsWith("/essays")) {
    codexLabel = "CODEX 02";
    codexTitle = "Codex 02 · Dispatches & Tracts";
  } else if (pathname.startsWith("/about")) {
    codexLabel = "CODEX 03";
    codexTitle = "Codex 03 · The Desert & Manifesto";
  } else if (pathname.startsWith("/contact")) {
    codexLabel = "CODEX 04";
    codexTitle = "Codex 04 · Correspondence";
  } else {
    codexLabel = "CODEX 00";
    codexTitle = "Codex 00 · The Void";
  }
} else if (!codexTitle) {
  if (codexLabel === "CODEX 00") {
    codexTitle = "Codex 00 · The Void";
  }
}
---

<header class="border-b border-[var(--color-rule)] pb-6 mb-10 text-center">
  <!-- Subtle VCR On-Screen Display (OSD) Bar -->
  <div class="flex items-center justify-between text-[10px] font-mono text-[var(--color-ink-faint)] tracking-widest uppercase mb-4 pb-2 border-b border-[var(--color-rule)] select-none">
    <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
      <button
        type="button"
        id="vhs-radio-btn"
        class="cursor-pointer text-[var(--color-ink-muted)] hover:text-[var(--color-ink-bright)] transition-colors py-1 px-1.5 -ml-1.5 min-h-[36px] inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider vhs-chromatic-hover select-none focus-visible:ring-1 focus-visible:ring-[var(--color-crimson)] group flex-shrink-0"
        aria-label="Play ambient soundscape (Opt-in)"
        title="Toggle ambient background soundscape (Opt-in)"
      >
        <span
          id="vhs-radio-led"
          class="w-1.5 h-1.5 rounded-full bg-[var(--color-vhs-green)] opacity-40 transition-all duration-300"
          aria-hidden="true"
        ></span>
        <span id="vhs-radio-action" class="font-normal text-[var(--color-ink-muted)] group-hover:text-[var(--color-crimson)] transition-colors">PLAY</span>
        <span id="vhs-radio-icon" class="inline-flex items-center text-[var(--color-ink-muted)] group-hover:text-[var(--color-crimson)] transition-colors">
          <svg id="vhs-icon-play" class="w-2.5 h-2.5 fill-current" viewBox="0 0 10 10" aria-hidden="true">
            <polygon points="2,1 8.5,5 2,9" />
          </svg>
          <svg id="vhs-icon-pause" class="hidden w-2.5 h-2.5 fill-current" viewBox="0 0 10 10" aria-hidden="true">
            <rect x="1.5" y="1" width="2.2" height="8" rx="0.4" />
            <rect x="6.3" y="1" width="2.2" height="8" rx="0.4" />
          </svg>
        </span>
        <span id="vhs-radio-tape" class="hidden min-[420px]:inline-flex items-center gap-1 text-[var(--color-ink-muted)]">
          <span>SP</span>
          <span id="vhs-radio-spool" class="hidden text-[10px] text-[var(--color-vhs-green)] font-normal animate-spin select-none" style="animation-duration: 3.5s;" aria-hidden="true">◐</span>
          <span id="vhs-radio-track-display" class="hidden min-[480px]:inline text-[9px] text-[var(--color-ink-faint)] select-none">1/7</span>
        </span>
      </button>

      <!-- Next Track Skip Button (Reveals when playing) -->
      <button
        type="button"
        id="vhs-radio-next-btn"
        class="hidden items-center justify-center cursor-pointer text-[var(--color-vhs-icon)] hover:text-[var(--color-crimson)] transition-colors py-1 px-1 -ml-0.5 min-h-[36px] min-w-[22px] font-mono text-[9px] uppercase tracking-wider select-none focus-visible:ring-1 focus-visible:ring-[var(--color-crimson)] flex-shrink-0"
        aria-label="Skip to next track"
        title="Next track"
      >
        <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 12 12" aria-hidden="true">
          <polygon points="1,2 6,6 1,10" />
          <polygon points="5.5,2 10.5,6 5.5,10" />
          <rect x="10" y="2" width="1.2" height="8" rx="0.3" />
        </svg>
      </button>

      <!-- Minimalist VHS Volume Control (Reveals ONLY when playing; collapsed by default) -->
      <div
        id="vhs-radio-vol-panel"
        class="hidden items-center text-[9px] font-mono text-[var(--color-ink-muted)] pl-1 sm:pl-1.5 border-l border-[var(--color-rule-light)] flex-shrink-0"
      >
        <!-- Volume Icon Button (Click on phone to toggle, hover on PC) -->
        <button
          type="button"
          id="vhs-vol-toggle-btn"
          class="cursor-pointer text-[var(--color-vhs-icon)] hover:text-[var(--color-crimson)] transition-colors py-1 px-1 min-h-[36px] min-w-[26px] inline-flex items-center justify-center select-none focus-visible:ring-1 focus-visible:ring-[var(--color-crimson)]"
          aria-label="Toggle volume slider"
          aria-expanded="false"
          title="Adjust volume"
        >
          <svg
            id="vhs-vol-icon"
            class="w-3.5 h-3.5 transition-colors"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M2 5.5v5h2.5L8 14V2L4.5 5.5H2z" />
            <path id="vhs-vol-wave-1" d="M10.5 5.5 C 12 6.5, 12 9.5, 10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            <path id="vhs-vol-wave-2" d="M12.5 3.5 C 15 5.5, 15 10.5, 12.5 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            <path id="vhs-vol-mute" class="hidden" d="M10.5 6 L 14.5 10 M 14.5 6 L 10.5 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </button>

        <!-- Expandable Volume Slider (Reveals on PC hover or Phone click) -->
        <div
          id="vhs-vol-slider-wrap"
          class="vhs-vol-slider-wrap"
        >
          <label for="vhs-radio-vol-slider" class="sr-only">Volume</label>
          <input
            type="range"
            id="vhs-radio-vol-slider"
            min="0"
            max="100"
            value="5"
            step="1"
            class="vhs-vol-range w-10 sm:w-14 cursor-pointer ml-0.5"
            aria-label="Volume"
            title="Adjust Volume"
          />
          <span id="vhs-radio-vol-label" class="font-mono text-[9px] text-[var(--color-ink-muted)] w-5 sm:w-6 tabular-nums select-none">5%</span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-1.5 sm:gap-2 text-[var(--color-ink-faint)] whitespace-nowrap">
      <span class="hidden min-[460px]:inline text-[var(--color-crimson)] font-normal tracking-wider" title={codexTitle}>{codexLabel}</span>
      <span class="hidden min-[460px]:inline">·</span>
      <span id="vhs-live-clock">--:--:--</span>
      <span>·</span>
      <button
        type="button"
        id="vhs-theme-toggle"
        class="cursor-pointer text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] transition-colors py-1 px-1.5 sm:px-2 min-h-[36px] inline-flex items-center justify-center gap-1 font-mono text-[10px] uppercase tracking-wider vhs-chromatic-hover select-none"
        aria-label="Toggle visual theme (Noir / Bone)"
        title="Toggle visual theme (Noir / Bone)"
      >
        <span id="vhs-theme-toggle-label" class="inline-flex items-center gap-1">
          <span>[</span>
          <span id="vhs-theme-toggle-icon" class="text-[14px] leading-none select-none">◐</span>
          <span id="vhs-theme-toggle-text">NOIR</span>
          <span>]</span>
        </span>
      </button>
    </div>
  </div>

  <div class="max-w-xl mx-auto px-4">
    <a href="/" class="no-underline inline-block group" aria-label="DissidentX Home">
      <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-black text-[var(--color-ink)] whitespace-nowrap vhs-chromatic-hover">
        Dissidentx<span class="text-[var(--color-crimson)]">.</span>
      </h1>
    </a>

    <p class="font-serif font-light italic text-base sm:text-lg text-[var(--color-ink-muted)] mt-1.5 tracking-wide">
      In pursuit of Truth.
    </p>
  </div>

  <!-- Minimalist Navigation -->
  <nav class="flex items-center justify-center gap-3 sm:gap-7 mt-5 sm:mt-6 text-xs font-mono tracking-widest uppercase" aria-label="Primary">
    {
      navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== "/" && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`transition-colors py-2 px-1 min-h-[44px] inline-flex items-center vhs-chromatic-hover border-b ${
              isActive
                ? "text-[var(--color-crimson)] border-[var(--color-crimson)]"
                : "text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] border-transparent"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }

    <!-- Search Trigger Button: unified sizing and stable layout to prevent flicker -->
    <button
      type="button"
      id="header-search-btn"
      class="group text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] transition-colors py-2 px-1.5 min-h-[44px] inline-flex items-center gap-1.5 cursor-pointer select-none vhs-chromatic-hover border-b border-transparent ml-0.5"
      aria-label="Search essays"
      title="Search essays (Press / to open)"
    >
      <span class="hidden sm:inline">Search</span>
      <span class="font-mono text-[10px] text-[var(--color-ink-faint)] group-hover:text-[var(--color-crimson)] group-hover:border-[var(--color-crimson)] border border-[var(--color-rule-light)] px-1.5 py-0.5 leading-none select-none transition-colors" aria-hidden="true">/</span>
    </button>
  </nav>
</header>

<script>
  let clockInterval: number | null = null;
  let audioFadeInterval: number | null = null;
  let volAutoCloseTimer: number | null = null;

  function clearVolAutoCloseTimer() {
    if (volAutoCloseTimer !== null) {
      window.clearTimeout(volAutoCloseTimer);
      volAutoCloseTimer = null;
    }
  }

  function closeVolPanel() {
    clearVolAutoCloseTimer();
    const volPanel = document.getElementById("vhs-radio-vol-panel");
    const volToggleBtn = document.getElementById("vhs-vol-toggle-btn");
    if (volPanel) volPanel.classList.remove("is-open");
    if (volToggleBtn) volToggleBtn.setAttribute("aria-expanded", "false");
  }

  function resetVolAutoCloseTimer() {
    clearVolAutoCloseTimer();
    const volPanel = document.getElementById("vhs-radio-vol-panel");
    if (volPanel && volPanel.classList.contains("is-open")) {
      volAutoCloseTimer = window.setTimeout(() => {
        closeVolPanel();
      }, 2000);
    }
  }

  function updateVhsClock() {
    const clock = document.getElementById("vhs-live-clock");
    if (!clock) return;
    const now = new Date();
    const h = String(now.getHours()).padStart(2, "0");
    const m = String(now.getMinutes()).padStart(2, "0");
    const s = String(now.getSeconds()).padStart(2, "0");
    clock.textContent = `${h}:${m}:${s}`;
  }

  function updateThemeToggleUI(theme: string) {
    const icon = document.getElementById("vhs-theme-toggle-icon");
    const text = document.getElementById("vhs-theme-toggle-text");
    if (icon) {
      icon.textContent = theme === "light" ? "◑" : "◐";
    }
    if (text) {
      text.textContent = theme === "light" ? "BONE" : "NOIR";
    }
  }

  function getSavedVolume(): number {
    try {
      const saved = localStorage.getItem("dissidentx:radio-vol");
      if (saved !== null) {
        const val = parseInt(saved, 10);
        if (!isNaN(val) && val >= 0 && val <= 100) return val;
      }
    } catch (_) {}
    return 5; // Default 5% volume as requested
  }

  function fadeAudio(audio: HTMLAudioElement, targetVolume: number, durationMs: number, onComplete?: () => void) {
    if (audioFadeInterval !== null) {
      clearInterval(audioFadeInterval);
      audioFadeInterval = null;
    }

    const startVolume = audio.volume;
    const startTime = performance.now();
    const stepInterval = 25;

    audioFadeInterval = window.setInterval(() => {
      const elapsed = performance.now() - startTime;
      const progress = Math.min(1, elapsed / durationMs);
      const factor = 0.5 * (1 - Math.cos(Math.PI * progress));
      audio.volume = Math.max(0, Math.min(1, startVolume + (targetVolume - startVolume) * factor));

      if (progress >= 1) {
        if (audioFadeInterval !== null) {
          clearInterval(audioFadeInterval);
          audioFadeInterval = null;
        }
        audio.volume = targetVolume;
        if (onComplete) onComplete();
      }
    }, stepInterval);
  }

  function updateVolIcon(vol: number) {
    const wave1 = document.getElementById("vhs-vol-wave-1");
    const wave2 = document.getElementById("vhs-vol-wave-2");
    const mute = document.getElementById("vhs-vol-mute");
    const icon = document.getElementById("vhs-vol-icon");

    if (vol === 0) {
      if (wave1) wave1.classList.add("hidden");
      if (wave2) wave2.classList.add("hidden");
      if (mute) mute.classList.remove("hidden");
      if (icon) icon.classList.add("text-[var(--color-crimson)]");
    } else if (vol < 50) {
      if (wave1) wave1.classList.remove("hidden");
      if (wave2) wave2.classList.add("hidden");
      if (mute) mute.classList.add("hidden");
      if (icon) icon.classList.remove("text-[var(--color-crimson)]");
    } else {
      if (wave1) wave1.classList.remove("hidden");
      if (wave2) wave2.classList.remove("hidden");
      if (mute) mute.classList.add("hidden");
      if (icon) icon.classList.remove("text-[var(--color-crimson)]");
    }
  }

  interface RadioTrack {
    id: string;
    title: string;
    artist: string;
    opus: string;
    mp3: string;
  }

  const VHS_PLAYLIST: RadioTrack[] = [
    { id: "midnight-forest", title: "Midnight Forest", artist: "Syouki Takahashi", opus: "/radio/vhs-midnight-forest.opus", mp3: "/radio/vhs-midnight-forest.mp3" },
    { id: "belong", title: "Belong", artist: "Sought After Sounds", opus: "/radio/vhs-belong.opus", mp3: "/radio/vhs-belong.mp3" },
    { id: "stray", title: "Stray", artist: "Sought After Sounds", opus: "/radio/vhs-stray.opus", mp3: "/radio/vhs-stray.mp3" },
    { id: "d-minor-phrase", title: "D Minor Phrase", artist: "Evan Boyerman", opus: "/radio/vhs-d-minor-phrase.opus", mp3: "/radio/vhs-d-minor-phrase.mp3" },
    { id: "shimmering-guitar", title: "Shimmering Guitar", artist: "Michi Jung", opus: "/radio/vhs-shimmering-guitar.opus", mp3: "/radio/vhs-shimmering-guitar.mp3" },
    { id: "hopeful-ambience", title: "Hopeful Ambience", artist: "Evan Boyerman", opus: "/radio/vhs-hopeful-ambience.opus", mp3: "/radio/vhs-hopeful-ambience.mp3" },
    { id: "tragic-strings", title: "Tragic Strings", artist: "Evan Boyerman", opus: "/radio/vhs-tragic-strings.opus", mp3: "/radio/vhs-tragic-strings.mp3" },
  ];

  let currentTrackIdx = 0;

  function getSavedTrackIndex(): number {
    try {
      const saved = localStorage.getItem("dissidentx:radio-track-idx");
      if (saved !== null) {
        const idx = parseInt(saved, 10);
        if (!isNaN(idx) && idx >= 0 && idx < VHS_PLAYLIST.length) return idx;
      }
    } catch (_) {}
    return 0;
  }

  function saveTrackIndex(idx: number) {
    currentTrackIdx = idx;
    try {
      localStorage.setItem("dissidentx:radio-track-idx", String(idx));
    } catch (_) {}
  }

  function getTrackUrl(audio: HTMLAudioElement, track: RadioTrack): string {
    const canPlayOpus = audio.canPlayType('audio/ogg; codecs="opus"') !== "" ||
                        audio.canPlayType('audio/opus') !== "";
    return canPlayOpus ? track.opus : track.mp3;
  }

  function syncTrackIdxFromAudio(audio: HTMLAudioElement) {
    if (!audio.src) {
      currentTrackIdx = getSavedTrackIndex();
      return;
    }
    const foundIdx = VHS_PLAYLIST.findIndex(t => audio.src.includes(t.opus) || audio.src.includes(t.mp3) || audio.src.includes(t.id));
    if (foundIdx !== -1) {
      currentTrackIdx = foundIdx;
    } else {
      currentTrackIdx = getSavedTrackIndex();
    }
  }

  function updateTrackDisplay(isPlaying: boolean) {
    const track = VHS_PLAYLIST[currentTrackIdx];
    const trackDisplay = document.getElementById("vhs-radio-track-display");
    const radioBtn = document.getElementById("vhs-radio-btn");
    const nextBtn = document.getElementById("vhs-radio-next-btn");

    if (trackDisplay) {
      trackDisplay.textContent = `${currentTrackIdx + 1}/${VHS_PLAYLIST.length}`;
      trackDisplay.title = `${track.title} (${currentTrackIdx + 1}/${VHS_PLAYLIST.length})`;
    }
    if (radioBtn) {
      const status = isPlaying ? "Playing" : "Paused";
      radioBtn.title = `${status}: ${track.title} · ${track.artist} (${currentTrackIdx + 1}/${VHS_PLAYLIST.length})`;
    }
    if (nextBtn) {
      if (isPlaying) {
        nextBtn.classList.remove("hidden");
        nextBtn.classList.add("inline-flex");
        const nextIdx = (currentTrackIdx + 1) % VHS_PLAYLIST.length;
        nextBtn.title = `Next: ${VHS_PLAYLIST[nextIdx].title}`;
      } else {
        nextBtn.classList.remove("inline-flex");
        nextBtn.classList.add("hidden");
      }
    }
  }

  function playTrack(index: number, autoFadeIn = true) {
    const audio = document.getElementById("vhs-radio-player") as HTMLAudioElement | null;
    if (!audio) return;
    saveTrackIndex(index);
    const track = VHS_PLAYLIST[index];
    const targetSrc = getTrackUrl(audio, track);

    if (!audio.src.endsWith(targetSrc)) {
      audio.src = targetSrc;
      audio.load();
    }

    const targetVol = getSavedVolume() / 100;
    if (autoFadeIn) {
      audio.volume = 0;
      audio.play().then(() => {
        fadeAudio(audio, targetVol, 700);
        updateRadioUI(true);
      }).catch((err) => {
        console.warn("VHS playback prevented:", err);
      });
    } else {
      audio.volume = targetVol;
      audio.play().then(() => {
        updateRadioUI(true);
      }).catch((err) => {
        console.warn("VHS playback prevented:", err);
      });
    }
  }

  function skipToNextTrack() {
    const audio = document.getElementById("vhs-radio-player") as HTMLAudioElement | null;
    if (!audio) return;
    const nextIdx = (currentTrackIdx + 1) % VHS_PLAYLIST.length;
    if (!audio.paused) {
      fadeAudio(audio, 0, 200, () => {
        playTrack(nextIdx, true);
      });
    } else {
      saveTrackIndex(nextIdx);
      const track = VHS_PLAYLIST[nextIdx];
      audio.src = getTrackUrl(audio, track);
      audio.load();
      updateTrackDisplay(false);
    }
  }

  function updateRadioUI(isPlaying: boolean) {
    const radioBtn = document.getElementById("vhs-radio-btn");
    const led = document.getElementById("vhs-radio-led");
    const action = document.getElementById("vhs-radio-action");
    const playIcon = document.getElementById("vhs-icon-play");
    const pauseIcon = document.getElementById("vhs-icon-pause");
    const spool = document.getElementById("vhs-radio-spool");
    const volPanel = document.getElementById("vhs-radio-vol-panel");
    const slider = document.getElementById("vhs-radio-vol-slider") as HTMLInputElement | null;
    const label = document.getElementById("vhs-radio-vol-label");

    if (!radioBtn) return;

    const savedVol = getSavedVolume();
    if (slider) slider.value = String(savedVol);
    if (label) label.textContent = `${savedVol}%`;
    updateVolIcon(savedVol);
    updateTrackDisplay(isPlaying);

    if (isPlaying) {
      radioBtn.setAttribute("aria-label", "Pause ambient soundscape");
      if (led) {
        led.classList.remove("opacity-40");
        led.classList.add("opacity-80", "shadow-[0_0_4px_var(--color-vhs-green)]");
      }
      if (action) action.textContent = "PAUSE";
      if (playIcon) playIcon.classList.add("hidden");
      if (pauseIcon) pauseIcon.classList.remove("hidden");
      if (spool) spool.classList.remove("hidden");
      if (volPanel) {
        volPanel.classList.remove("hidden");
        volPanel.classList.add("inline-flex");
      }
    } else {
      radioBtn.setAttribute("aria-label", "Play ambient soundscape (Opt-in)");
      if (led) {
        led.classList.remove("opacity-80", "shadow-[0_0_4px_var(--color-vhs-green)]");
        led.classList.add("opacity-40");
      }
      if (action) action.textContent = "PLAY";
      if (playIcon) playIcon.classList.remove("hidden");
      if (pauseIcon) pauseIcon.classList.add("hidden");
      if (spool) spool.classList.add("hidden");
      if (volPanel) {
        volPanel.classList.remove("inline-flex");
        volPanel.classList.add("hidden");
        closeVolPanel();
      }
    }
  }

  function toggleRadioAudio() {
    const audio = document.getElementById("vhs-radio-player") as HTMLAudioElement | null;
    if (!audio) return;

    if (audio.paused) {
      const track = VHS_PLAYLIST[currentTrackIdx];
      const targetSrc = getTrackUrl(audio, track);
      if (!audio.src || !audio.src.endsWith(targetSrc)) {
        audio.src = targetSrc;
        audio.load();
      }
      const targetVol = getSavedVolume() / 100;
      audio.volume = 0;
      audio.play().then(() => {
        fadeAudio(audio, targetVol, 1000);
        updateRadioUI(true);
      }).catch((err) => {
        console.warn("VHS playback prevented:", err);
      });
    } else {
      updateRadioUI(false);
      fadeAudio(audio, 0, 350, () => {
        audio.pause();
      });
    }
  }

  function initHeader() {
    updateVhsClock();
    if (clockInterval === null) {
      clockInterval = window.setInterval(updateVhsClock, 1000);
    }

    const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
    updateThemeToggleUI(currentTheme);

    const audio = document.getElementById("vhs-radio-player") as HTMLAudioElement | null;
    if (audio) {
      syncTrackIdxFromAudio(audio);
      updateRadioUI(!audio.paused);
      if (!audio.dataset.listenersBound) {
        audio.dataset.listenersBound = "true";
        audio.addEventListener("play", () => updateRadioUI(true));
        audio.addEventListener("pause", () => updateRadioUI(false));
        audio.addEventListener("ended", () => {
          const nextIdx = (currentTrackIdx + 1) % VHS_PLAYLIST.length;
          playTrack(nextIdx, true);
        });
      }
    }

    const radioBtn = document.getElementById("vhs-radio-btn");
    if (radioBtn && !radioBtn.dataset.bound) {
      radioBtn.dataset.bound = "true";
      radioBtn.addEventListener("click", () => {
        toggleRadioAudio();
        radioBtn.blur();
      });
    }

    const nextBtn = document.getElementById("vhs-radio-next-btn");
    if (nextBtn && !nextBtn.dataset.bound) {
      nextBtn.dataset.bound = "true";
      nextBtn.addEventListener("click", () => {
        skipToNextTrack();
        nextBtn.blur();
      });
    }

    const volToggleBtn = document.getElementById("vhs-vol-toggle-btn");
    const volPanel = document.getElementById("vhs-radio-vol-panel");
    if (volToggleBtn && !volToggleBtn.dataset.bound) {
      volToggleBtn.dataset.bound = "true";
      volToggleBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!volPanel) return;
        const isOpen = volPanel.classList.toggle("is-open");
        volToggleBtn.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) {
          resetVolAutoCloseTimer();
        } else {
          clearVolAutoCloseTimer();
        }
      });
    }

    if (volPanel && !volPanel.dataset.hoverBound) {
      volPanel.dataset.hoverBound = "true";
      volPanel.addEventListener("mouseleave", () => {
        closeVolPanel();
      });
      volPanel.addEventListener("pointerdown", () => {
        resetVolAutoCloseTimer();
      });
      volPanel.addEventListener("touchstart", () => {
        resetVolAutoCloseTimer();
      }, { passive: true });
    }

    if (!document.documentElement.dataset.volGlobalBound) {
      document.documentElement.dataset.volGlobalBound = "true";
      document.addEventListener("click", (e) => {
        const vp = document.getElementById("vhs-radio-vol-panel");
        if (!vp || !vp.classList.contains("is-open")) return;
        if (!vp.contains(e.target as Node)) {
          closeVolPanel();
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const vp = document.getElementById("vhs-radio-vol-panel");
          if (vp && vp.classList.contains("is-open")) {
            closeVolPanel();
          }
        }
      });
    }

    const volSlider = document.getElementById("vhs-radio-vol-slider") as HTMLInputElement | null;
    const volLabel = document.getElementById("vhs-radio-vol-label");
    if (volSlider && !volSlider.dataset.bound) {
      volSlider.dataset.bound = "true";
      volSlider.value = String(getSavedVolume());
      if (volLabel) volLabel.textContent = `${volSlider.value}%`;

      volSlider.addEventListener("input", () => {
        resetVolAutoCloseTimer();
        if (audioFadeInterval !== null) {
          clearInterval(audioFadeInterval);
          audioFadeInterval = null;
        }
        const val = parseInt(volSlider.value, 10);
        if (volLabel) volLabel.textContent = `${val}%`;
        updateVolIcon(val);
        const activeAudio = document.getElementById("vhs-radio-player") as HTMLAudioElement | null;
        if (activeAudio) {
          activeAudio.volume = val / 100;
        }
        try {
          localStorage.setItem("dissidentx:radio-vol", String(val));
        } catch (_) {}
      });

      volSlider.addEventListener("change", () => {
        resetVolAutoCloseTimer();
      });
    }

    const toggleBtn = document.getElementById("vhs-theme-toggle");
    if (toggleBtn && !toggleBtn.dataset.bound) {
      toggleBtn.dataset.bound = "true";
      toggleBtn.addEventListener("click", () => {
        const active = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        const nextTheme = active === "light" ? "dark" : "light";

        document.documentElement.setAttribute("data-theme", nextTheme);
        try {
          localStorage.setItem("theme", nextTheme);
        } catch (_) {}

        const meta = document.getElementById("meta-theme-color");
        if (meta) {
          meta.setAttribute("content", nextTheme === "light" ? "#faf6ee" : "#020202");
        }

        updateThemeToggleUI(nextTheme);
        window.dispatchEvent(new CustomEvent("dissidentx:theme-change", { detail: { theme: nextTheme } }));
        toggleBtn.blur();
      });
    }

    const searchBtn = document.getElementById("header-search-btn");
    if (searchBtn && !searchBtn.dataset.bound) {
      searchBtn.dataset.bound = "true";
      searchBtn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("dissidentx:open-search"));
      });
    }
  }

  window.addEventListener("dissidentx:theme-change", (e: any) => {
    if (e.detail?.theme) {
      updateThemeToggleUI(e.detail.theme);
    }
  });

  document.addEventListener("astro:before-swap", closeVolPanel);
  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
