---
import { formatDate, toRoman, type EssayEntry } from "../lib/essays";

interface Props {
  essays: EssayEntry[];
}

const { essays } = Astro.props;
const allTags = Array.from(new Set(essays.flatMap((e) => e.data.tags || [])));
---

<div class="border border-[var(--color-rule)] bg-[var(--color-surface)] p-4 sm:p-7 my-6 min-h-[460px] flex flex-col justify-start">
  <!-- Interactive Search & Tag Bar (Aligned with Monastic Zine Aesthetic) -->
  <div class="mb-6 pb-5 border-b border-[var(--color-rule)] space-y-3">
    <!-- Search Input Form with explicit [ SEARCH ↵ ] button -->
    <form id="archive-search-form" role="search" class="flex items-center gap-2 sm:gap-2.5">
      <div class="flex-1 relative flex items-center bg-[var(--color-void)] border border-[var(--color-rule)] focus-within:border-[var(--color-crimson-subtle)] transition-colors px-3 h-10 min-h-[40px]">
        <span class="text-[var(--color-crimson)] opacity-75 font-mono text-xs select-none flex-shrink-0 mr-2.5" aria-hidden="true">[ ? ]</span>
        <label for="archive-search-input" class="sr-only">Filter dispatches</label>
        <input
          type="text"
          id="archive-search-input"
          placeholder="Filter dispatches by keyword, tag, or content..."
          class="w-full bg-transparent border-none outline-none text-xs font-mono text-[var(--color-ink)] placeholder-[var(--color-ink-faint)] tracking-wide focus:outline-none focus-visible:outline-none focus:ring-0"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="archive-search-clear"
          class="hidden text-[10px] font-mono text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] cursor-pointer select-none ml-1.5 flex-shrink-0 p-1 min-h-[28px] min-w-[28px] inline-flex items-center justify-center transition-colors"
          title="Clear filter"
          aria-label="Clear filter"
        >
          [ ✕ ]
        </button>
      </div>
      <button
        type="submit"
        id="archive-search-submit"
        class="flex-shrink-0 font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] hover:border-[var(--color-crimson-subtle)] focus-visible:border-[var(--color-crimson-subtle)] focus-visible:text-[var(--color-crimson)] border border-[var(--color-rule)] bg-[var(--color-void)] px-3 sm:px-3.5 h-10 min-h-[40px] cursor-pointer transition-colors select-none inline-flex items-center justify-center gap-1.5 outline-none focus:outline-none focus:ring-0 active:scale-[0.98]"
        title="Execute search"
        aria-label="Execute search"
      >
        <span class="hidden sm:inline">SEARCH</span>
        <span class="text-[var(--color-crimson)] font-bold text-xs select-none">↵</span>
      </button>
    </form>

    <!-- Status Sub-Bar: Topics Label & Match Count -->
    <div class="flex items-center justify-between text-[10px] font-mono text-[var(--color-ink-faint)] uppercase tracking-wider pt-0.5">
      <div class="flex items-center gap-1.5">
        <span class="w-1 h-1 rounded-full bg-[var(--color-crimson)]"></span>
        <span class="tracking-widest text-[var(--color-ink-muted)]">TOPICS</span>
      </div>
      <span id="archive-count-text" aria-live="polite" aria-atomic="true">
        DISPATCHES: {essays.length} OF {essays.length}
      </span>
    </div>

    <!-- Tag Filter Pills: 3 uniform columns on phone with snug vertical spacing -->
    <div class="grid grid-cols-3 gap-x-1.5 gap-y-1 sm:flex sm:flex-wrap sm:justify-start sm:gap-x-2.5 sm:gap-y-1.5 text-xs font-mono w-full pt-0.5" role="toolbar" aria-label="Topic filters">
      <button
        type="button"
        class="archive-tag-pill active text-[9px] min-[390px]:text-[10px] font-mono uppercase text-[var(--color-crimson)] font-bold cursor-pointer transition-colors py-1 px-1.5 min-h-[26px] sm:min-h-[28px] leading-tight inline-flex items-center justify-center sm:justify-start w-full sm:w-auto text-center whitespace-nowrap tracking-tight sm:tracking-normal"
        data-tag=""
        aria-pressed="true"
      >
        [ ALL ]
      </button>
      {
        allTags.map((tag) => (
          <button
            type="button"
            class="archive-tag-pill text-[9px] min-[390px]:text-[10px] font-mono uppercase text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] cursor-pointer transition-colors py-1 px-1.5 min-h-[26px] sm:min-h-[28px] leading-tight inline-flex items-center justify-center sm:justify-start w-full sm:w-auto text-center whitespace-nowrap tracking-tight sm:tracking-normal"
            data-tag={tag}
            aria-pressed="false"
          >
            [ #{tag} ]
          </button>
        ))
      }
    </div>
  </div>

  <!-- List -->
  <ul id="archive-essay-list" class="divide-y divide-[var(--color-rule)]">
    {
      essays.map((essay, idx) => (
        <li
          class="archive-essay-item py-5 first:pt-0 last:pb-0 group transition-opacity"
          data-id={essay.id}
          data-title={essay.data.title}
          data-description={essay.data.description}
          data-tags={(essay.data.tags || []).join(",")}
        >
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <!-- Left: Numeral & Title -->
            <div class="flex items-baseline gap-3 flex-1 min-w-0">
              <span class="text-[var(--color-crimson)] font-mono text-xs font-bold w-8 flex-shrink-0">
                {toRoman(idx + 1)}.
              </span>
              <a
                href={`/essays/${essay.id}`}
                class="archive-essay-title font-serif text-base sm:text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-crimson)] transition-colors leading-snug"
              >
                {essay.data.title}
              </a>
            </div>

            <!-- Metadata: Tag on Left, Date on Right on Phone; Grouped Right on Desktop -->
            <div class="flex items-center justify-between sm:justify-end gap-3 font-mono text-xs text-[var(--color-ink-faint)] w-full sm:w-auto pl-11 sm:pl-0 flex-shrink-0">
              {essay.data.tags && essay.data.tags.length > 0 && (
                <span class="text-[10px] uppercase text-[var(--color-ink-muted)]">
                  #{essay.data.tags[0]}
                </span>
              )}
              <time datetime={essay.data.pubDate.toISOString()}>
                {formatDate(essay.data.pubDate)}
              </time>
            </div>
          </div>

          <!-- Description -->
          <p class="archive-essay-desc font-serif text-xs sm:text-sm text-[var(--color-ink-muted)] mt-1.5 pl-11 line-clamp-2 leading-relaxed">
            {essay.data.description}
          </p>

          <!-- Dynamic Contextual Snippet (Revealed when search matches body content) -->
          <div class="archive-essay-snippet hidden text-[11px] font-mono text-[var(--color-ink-muted)] bg-[var(--color-void)] ml-11 mt-2.5 px-3 py-1.5 border-l-2 border-[var(--color-highlight-border)] line-clamp-2 leading-relaxed">
          </div>
        </li>
      ))
    }
  </ul>

  <!-- Empty State -->
  <div id="archive-no-results" class="hidden py-16 text-center select-none flex-1 flex flex-col items-center justify-center">
    <span class="text-[var(--color-crimson)] text-xs mb-2 font-mono">✕</span>
    <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-bright)] mb-1.5">No dispatches found</p>
    <p class="font-serif italic text-xs text-[var(--color-ink-muted)] mb-4 max-w-xs leading-relaxed">
      No writings match your criteria. Try clearing active filters or relaxing keywords.
    </p>
    <button
      type="button"
      id="archive-reset-btn"
      class="text-xs font-mono text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] uppercase tracking-wider transition-colors cursor-pointer min-h-[44px] inline-flex items-center justify-center py-2 px-3"
    >
      [ RESET FILTER ]
    </button>
  </div>
</div>

<script>
  interface SearchIndexEntry {
    id: string;
    title: string;
    description: string;
    tags: string[];
    categoryTag: string;
    date: string;
    timestamp: number;
    content: string;
  }

  interface MatchInfo {
    doc: SearchIndexEntry;
    matchedInBody: boolean;
    tokens: string[];
  }

  let searchIndex: SearchIndexEntry[] | null = null;
  let currentActiveTag = "";

  function escapeHtml(str: string): string {
    if (!str) return "";
    return str.replace(/[&<>"']/g, (m) => {
      switch (m) {
        case "&": return "&amp;";
        case "<": return "&lt;";
        case ">": return "&gt;";
        case '"': return "&quot;";
        case "'": return "&#39;";
        default: return m;
      }
    });
  }

  function highlightTerms(text: string, tokens: string[]): string {
    if (!tokens || tokens.length === 0) return escapeHtml(text);
    const escapedTokens = tokens
      .filter(Boolean)
      .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
      .sort((a, b) => b.length - a.length);
    if (escapedTokens.length === 0) return escapeHtml(text);

    const regex = new RegExp(`(${escapedTokens.join("|")})`, "gi");
    const safeText = escapeHtml(text);
    return safeText.replace(
      regex,
      '<mark class="bg-[var(--color-highlight-bg)] text-[var(--color-highlight-text)] font-semibold px-0.5 rounded-none">$1</mark>'
    );
  }

  function extractSnippet(content: string, tokens: string[], maxChars = 140): string {
    if (!content) return "";
    const lowerContent = content.toLowerCase();

    let bestIdx = -1;
    let matchedTok = "";
    for (const tok of tokens) {
      const idx = lowerContent.indexOf(tok);
      if (idx !== -1 && (bestIdx === -1 || idx < bestIdx)) {
        bestIdx = idx;
        matchedTok = tok;
      }
    }

    if (bestIdx === -1) {
      const slice = content.slice(0, maxChars);
      return highlightTerms(slice + (content.length > maxChars ? "..." : ""), tokens);
    }

    const start = Math.max(0, bestIdx - 45);
    const end = Math.min(content.length, bestIdx + matchedTok.length + 80);
    let snippet = content.slice(start, end);

    if (start > 0) {
      const firstSpace = snippet.indexOf(" ");
      if (firstSpace !== -1 && firstSpace < 15) {
        snippet = snippet.slice(firstSpace + 1);
      }
      snippet = "..." + snippet;
    }
    if (end < content.length) {
      const lastSpace = snippet.lastIndexOf(" ");
      if (lastSpace !== -1 && lastSpace > snippet.length - 15) {
        snippet = snippet.slice(0, lastSpace);
      }
      snippet = snippet + "...";
    }

    return highlightTerms(snippet, tokens);
  }

  function setupArchive() {
    const searchForm = document.getElementById("archive-search-form") as HTMLFormElement | null;
    const searchInput = document.getElementById("archive-search-input") as HTMLInputElement | null;
    const submitBtn = document.getElementById("archive-search-submit") as HTMLButtonElement | null;
    const clearBtn = document.getElementById("archive-search-clear");
    const countText = document.getElementById("archive-count-text");
    const noResults = document.getElementById("archive-no-results");
    const resetBtn = document.getElementById("archive-reset-btn");
    const tagPills = document.querySelectorAll<HTMLButtonElement>(".archive-tag-pill");
    const essayItems = document.querySelectorAll<HTMLElement>(".archive-essay-item");

    if (!searchInput || !tagPills.length) return;
    if (searchInput.dataset.bound) {
      (window as any).__dissidentx_loadArchiveUrl?.();
      return;
    }
    searchInput.dataset.bound = "true";

    // Cache original titles and descriptions to allow clean highlight toggling
    essayItems.forEach((item) => {
      const titleLink = item.querySelector<HTMLAnchorElement>(".archive-essay-title");
      const descEl = item.querySelector<HTMLElement>(".archive-essay-desc");
      if (titleLink && !item.dataset.originalTitle) {
        item.dataset.originalTitle = titleLink.textContent?.trim() || "";
      }
      if (descEl && !item.dataset.originalDesc) {
        item.dataset.originalDesc = descEl.textContent?.trim() || "";
      }
    });

    async function initSearch() {
      if (searchIndex) return;
      try {
        const res = await fetch("/search-index.json");
        if (!res.ok) return;
        searchIndex = await res.json();
      } catch (e) {
        console.error("Failed to initialize archive search index:", e);
      }
    }

    function filterEssays() {
      const query = searchInput?.value.trim() || "";
      const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
      clearBtn?.classList.toggle("hidden", !query);

      let matchedMap: Map<string, MatchInfo> | null = null;
      let fallbackMatchedIds: Set<string> | null = null;

      if (tokens.length > 0) {
        if (searchIndex) {
          matchedMap = new Map();
          for (const doc of searchIndex) {
            const titleLower = (doc.title || "").toLowerCase();
            const descLower = (doc.description || "").toLowerCase();
            const tagsLower = (doc.tags || []).map((t) => t.toLowerCase());
            const contentLower = (doc.content || "").toLowerCase();

            // Strict AND evaluation across all fields
            const matchesAll = tokens.every(
              (tok) =>
                titleLower.includes(tok) ||
                descLower.includes(tok) ||
                tagsLower.some((t) => t.includes(tok)) ||
                contentLower.includes(tok)
            );

            if (matchesAll) {
              const matchedInBody = tokens.some((tok) => contentLower.includes(tok));
              matchedMap.set(doc.id, { doc, matchedInBody, tokens });
            }
          }
        } else {
          // Instant synchronous DOM fallback matching before async fetch finishes
          fallbackMatchedIds = new Set();
          essayItems.forEach((item) => {
            const id = item.getAttribute("data-id") || "";
            const title = (item.getAttribute("data-title") || "").toLowerCase();
            const desc = (item.getAttribute("data-description") || "").toLowerCase();
            const tags = (item.getAttribute("data-tags") || "").toLowerCase();
            const matchesAll = tokens.every(
              (tok) => title.includes(tok) || desc.includes(tok) || tags.includes(tok)
            );
            if (matchesAll) {
              fallbackMatchedIds?.add(id);
            }
          });
        }
      }

      let visibleCount = 0;

      essayItems.forEach((item) => {
        const id = item.getAttribute("data-id") || "";
        const itemTags = (item.getAttribute("data-tags") || "").split(",").map((t) => t.trim().toLowerCase());
        const originalTitle = item.dataset.originalTitle || item.getAttribute("data-title") || "";
        const originalDesc = item.dataset.originalDesc || item.getAttribute("data-description") || "";

        const titleLink = item.querySelector<HTMLAnchorElement>(".archive-essay-title");
        const descEl = item.querySelector<HTMLElement>(".archive-essay-desc");
        const snippetEl = item.querySelector<HTMLElement>(".archive-essay-snippet");

        const matchesQuery =
          tokens.length === 0 ||
          (matchedMap ? matchedMap.has(id) : fallbackMatchedIds?.has(id) ?? false);

        const matchesTag = !currentActiveTag || itemTags.includes(currentActiveTag.toLowerCase());

        if (matchesQuery && matchesTag) {
          item.style.display = "";
          visibleCount++;

          if (tokens.length > 0) {
            if (titleLink) titleLink.innerHTML = highlightTerms(originalTitle, tokens);
            if (descEl) descEl.innerHTML = highlightTerms(originalDesc, tokens);

            const matchInfo = matchedMap?.get(id);
            if (matchInfo && snippetEl) {
              const snippet = extractSnippet(matchInfo.doc.content, tokens);
              if (snippet) {
                snippetEl.innerHTML = `<span class="text-[9px] uppercase tracking-wider text-[var(--color-ink-faint)] block mb-0.5 select-none font-sans">MATCHED IN CONTENT:</span>${snippet}`;
                snippetEl.classList.remove("hidden");
              } else {
                snippetEl.classList.add("hidden");
              }
            } else if (snippetEl) {
              snippetEl.classList.add("hidden");
            }
          } else {
            if (titleLink) titleLink.textContent = originalTitle;
            if (descEl) descEl.textContent = originalDesc;
            if (snippetEl) snippetEl.classList.add("hidden");
          }
        } else {
          item.style.display = "none";
          if (titleLink) titleLink.textContent = originalTitle;
          if (descEl) descEl.textContent = originalDesc;
          if (snippetEl) snippetEl.classList.add("hidden");
        }
      });

      if (countText) {
        if (query && currentActiveTag) {
          countText.textContent = `FILTERED: "${query}" (#${currentActiveTag.toUpperCase()}) · ${visibleCount} OF ${essayItems.length}`;
        } else if (query) {
          countText.textContent = `FILTERED BY: "${query}" · ${visibleCount} OF ${essayItems.length}`;
        } else if (currentActiveTag) {
          countText.textContent = `TOPIC: #${currentActiveTag.toUpperCase()} · ${visibleCount} OF ${essayItems.length}`;
        } else {
          countText.textContent = `DISPATCHES: ${essayItems.length} OF ${essayItems.length}`;
        }
      }

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    }

    function syncUrl(push = false) {
      const query = searchInput?.value.trim() || "";
      const params = new URLSearchParams();
      if (query) params.set("q", query);
      if (currentActiveTag) params.set("tag", currentActiveTag);

      const queryString = params.toString();
      const newRelativePath = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;

      if (window.location.pathname + window.location.search !== newRelativePath) {
        if (push) {
          window.history.pushState({ q: query, tag: currentActiveTag }, "", newRelativePath);
        } else {
          window.history.replaceState({ q: query, tag: currentActiveTag }, "", newRelativePath);
        }
      }
    }

    function loadFromUrl() {
      const urlParams = new URLSearchParams(window.location.search);
      const qParam = urlParams.get("q") || urlParams.get("search") || "";
      const tagParam = urlParams.get("tag") || "";

      if (searchInput) {
        searchInput.value = qParam;
      }

      currentActiveTag = tagParam;
      tagPills.forEach((p) => {
        const pillTag = p.getAttribute("data-tag") || "";
        const isActive = tagParam ? pillTag.toLowerCase() === tagParam.toLowerCase() : pillTag === "";
        p.classList.toggle("active", isActive);
        p.classList.toggle("text-[var(--color-crimson)]", isActive);
        p.classList.toggle("font-bold", isActive);
        p.classList.toggle("text-[var(--color-ink-muted)]", !isActive);
        p.setAttribute("aria-pressed", String(isActive));
      });

      // Filter immediately with synchronous DOM fallback
      filterEssays();

      // Deepen search when index loads
      if (qParam) {
        initSearch().then(filterEssays);
      }
    }

    (window as any).__dissidentx_loadArchiveUrl = loadFromUrl;

    // Preload on focus or hover
    searchInput.addEventListener("focus", initSearch);
    searchInput.addEventListener("mouseenter", initSearch);

    let debounceTimer: number | undefined;
    searchInput.addEventListener("input", () => {
      window.clearTimeout(debounceTimer);
      if (!searchIndex) {
        initSearch().then(() => {
          filterEssays();
          syncUrl(false);
        });
      } else {
        filterEssays();
        debounceTimer = window.setTimeout(() => {
          syncUrl(false);
        }, 150);
      }
    });

    // Seamlessly fade button into inactive state after clicking/tapping
    const handleButtonRelease = () => {
      setTimeout(() => {
        submitBtn?.blur();
      }, 80);
    };

    submitBtn?.addEventListener("pointerup", handleButtonRelease);
    submitBtn?.addEventListener("touchend", handleButtonRelease);

    // Form submit via [ SEARCH ↵ ] or pressing Enter
    searchForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      handleButtonRelease();
      syncUrl(true);
      if (!searchIndex) {
        initSearch().then(filterEssays);
      } else {
        filterEssays();
      }
    });

    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      filterEssays();
      syncUrl(true);
      searchInput.focus();
    });

    resetBtn?.addEventListener("click", () => {
      searchInput.value = "";
      currentActiveTag = "";
      tagPills.forEach((p) => {
        const isAll = p.getAttribute("data-tag") === "";
        p.classList.toggle("active", isAll);
        p.classList.toggle("text-[var(--color-crimson)]", isAll);
        p.classList.toggle("font-bold", isAll);
        p.classList.toggle("text-[var(--color-ink-muted)]", !isAll);
        p.setAttribute("aria-pressed", String(isAll));
      });
      filterEssays();
      syncUrl(true);
    });

    tagPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const tag = pill.getAttribute("data-tag") || "";
        currentActiveTag = tag;

        tagPills.forEach((p) => {
          const isActive = p === pill;
          p.classList.toggle("active", isActive);
          p.classList.toggle("text-[var(--color-crimson)]", isActive);
          p.classList.toggle("font-bold", isActive);
          p.classList.toggle("text-[var(--color-ink-muted)]", !isActive);
          p.setAttribute("aria-pressed", String(isActive));
        });

        if (!searchIndex) {
          initSearch().then(() => {
            filterEssays();
            syncUrl(true);
          });
        } else {
          filterEssays();
          syncUrl(true);
        }
      });
    });

    // Apply URL params on page load
    loadFromUrl();

    // Re-apply if user presses browser Back/Forward
    window.addEventListener("popstate", () => {
      loadFromUrl();
    });
  }

  // Setup on initial load and client navigations
  setupArchive();
  document.addEventListener("astro:page-load", setupArchive);
</script>

<style>
  #archive-search-input,
  #archive-search-input:focus,
  #archive-search-input:focus-visible {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
  }

  #archive-search-submit,
  #archive-search-submit:focus,
  #archive-search-submit:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }
</style>
