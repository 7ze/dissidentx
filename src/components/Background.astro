---
/**
 * Background.astro
 * Full-viewport seamless vector wallpaper featuring an alternating 2x2 sacred
 * Christian mandala tapestry:
 * 1. The Eucharistic Cathedral Rose Window (Central Chalice, Host, 8-fold Gothic petals, crosses, wheat, grapes)
 * 2. The Byzantine Fourfold Chalice (Chi-Rho center, 4 radial cardinal chalices, diagonal crosses)
 *
 * Finished with a full-screen angled gilded linear gradient (ornamental sun rays):
 * Streaming diagonally from celestial golden radiance in the upper quadrant,
 * transitioning through antique bronze into deep monastic charcoal.
 *
 * Fully customizable via CSS tokens in src/styles/global.css:
 * --wallpaper-tile-size: size of a single motif (defaults to 500px)
 * --wallpaper-opacity: opacity (defaults to 0.05)
 * --wallpaper-sunray-start / gold / bronze / end: gradient color stops
 */

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  id="wallpaper-layer"
  transition:persist="wallpaper-layer"
  class:list={[
    "fixed inset-0 pointer-events-none select-none z-0 overflow-hidden wallpaper-container",
    className,
  ]}
  aria-hidden="true"
>
  <svg class="w-full h-full block wallpaper-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <defs>
<defs>
  <!-- Chalice Motif -->
  <g id="mandala-chalice">
    <!-- Radiant Halo -->
    <circle cx="0" cy="-45" r="22" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity="0.5" />
    <circle cx="0" cy="-45" r="16" fill="var(--bg-fill, #020202)" stroke="currentColor" stroke-width="2" />
    <!-- Greek Cross in Host -->
    <line x1="-8" y1="-45" x2="8" y2="-45" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <line x1="0" y1="-53" x2="0" y2="-37" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <circle cx="-8" cy="-45" r="1.5" fill="currentColor" />
    <circle cx="8" cy="-45" r="1.5" fill="currentColor" />
    <circle cx="0" cy="-53" r="1.5" fill="currentColor" />
    <circle cx="0" cy="-37" r="1.5" fill="currentColor" />
    <!-- Cup Body -->
    <path d="M -28,-22 C -28,15 0,34 0,34 C 0,34 28,15 28,-22 Z" fill="var(--bg-fill, #020202)" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
    <path d="M -23,-18 C -23,10 0,27 0,27 C 0,27 23,10 23,-18" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6" />
    <ellipse cx="0" cy="-22" rx="28" ry="6" fill="var(--bg-fill, #020202)" stroke="currentColor" stroke-width="2.5" />
    <ellipse cx="0" cy="-22" rx="22" ry="3.5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <!-- Stem & Jeweled Knop -->
    <path d="M -5,34 L -5,64 L 5,64 L 5,34 Z" fill="var(--bg-fill, #020202)" stroke="currentColor" stroke-width="2" />
    <polygon points="0,43 10,49 10,55 0,61 -10,55 -10,49" fill="currentColor" />
    <circle cx="0" cy="52" r="3" fill="var(--bg-fill, #020202)" />
    <circle cx="0" cy="52" r="1.2" fill="currentColor" />
    <!-- Foot -->
    <path d="M -6,64 C -14,70 -30,80 -32,90 L 32,90 C 30,80 14,70 6,64 Z" fill="var(--bg-fill, #020202)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
