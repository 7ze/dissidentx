<script is:inline>
  (() => {
    function syncWallpaper() {
      try {
        const pattern = document.getElementById("bg-mandala-mask");
        if (!pattern) return;

        // Read tile size from CSS custom property (--wallpaper-tile-size)
        const style = getComputedStyle(document.documentElement);
        const rawSize = style.getPropertyValue("--wallpaper-tile-size").trim();
        const tileSize = parseFloat(rawSize) || 500;
        const patternSize = tileSize * 2; // 2x2 grid repeat

        // Dynamically update pattern dimensions from CSS
        pattern.setAttribute("width", patternSize.toString());
        pattern.setAttribute("height", patternSize.toString());

        // Center motif symmetrically on mobile & desktop
        const w = window.innerWidth;
        let offset = ((w / 2) - (tileSize / 2)) % patternSize;
        if (offset < 0) offset += patternSize;
        pattern.setAttribute("x", offset.toFixed(1));
      } catch (_) {}
    }

    syncWallpaper();
    window.addEventListener("resize", syncWallpaper, { passive: true });
    document.addEventListener("astro:page-load", syncWallpaper);
    document.addEventListener("astro:after-swap", syncWallpaper);
  })();
</script>

<style>
  .wallpaper-container {
    contain: strict;
    -webkit-mask-image: var(
      --wallpaper-fade,
      linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.75) 25%, rgba(0, 0, 0, 0.25) 55%, transparent 80%)
    );
    mask-image: var(
      --wallpaper-fade,
      linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.75) 25%, rgba(0, 0, 0, 0.25) 55%, transparent 80%)
    );
  }

  .wallpaper-svg {
    color: var(--color-wallpaper, #363636);
  }

  .wallpaper-mesh {
    opacity: var(--wallpaper-opacity, 0.05);
