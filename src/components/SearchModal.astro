---
// Global Search Modal Component (Themed: Monastic / VHS OSD Terminal)
---

<dialog
  id="search-modal"
  class="fixed inset-0 m-auto w-[92vw] max-w-2xl h-[520px] max-h-[82vh] bg-[var(--color-surface)] border border-[var(--color-rule-light)] text-[var(--color-ink)] p-0 z-50 shadow-2xl rounded-none outline-none"
  aria-label="Search DissidentX Essays"
  transition:persist
>
  <!-- VCR OSD / Monastic Terminal Top Bar -->
  <div class="flex-shrink-0 px-4 sm:px-5 py-2.5 bg-[var(--color-surface)] border-b border-[var(--color-rule)] flex items-center justify-between text-[10px] font-mono tracking-widest uppercase text-[var(--color-ink-faint)] select-none">
    <div class="flex items-center gap-2 text-[var(--color-ink-muted)]">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-vhs-green)] opacity-80 animate-pulse"></span>
      <span class="font-semibold text-[var(--color-ink-bright)] opacity-90">SEARCH</span>
      <span class="text-[var(--color-ink-faint)]">·</span>
      <span>ARCHIVE DISPATCHES</span>
    </div>
    <div class="flex items-center gap-3">
      <span id="search-match-count" class="text-[var(--color-crimson)] font-medium" aria-live="polite" aria-atomic="true">READY</span>
      <span>·</span>
      <button
        id="search-close-btn"
        type="button"
        class="cursor-pointer text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] transition-colors py-1 px-2 min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
        title="Press Escape to close"
        aria-label="Close search dialog"
      >
        [ ESC ]
      </button>
    </div>
  </div>

  <!-- Search Input Bar (Accessible form with explicit execute button and clear affordance) -->
  <form
    id="search-form"
    role="search"
    action="/essays"
    method="GET"
    class="flex-shrink-0 px-4 sm:px-5 py-3 bg-[var(--color-surface)] border-b border-[var(--color-rule)] focus-within:border-[var(--color-crimson-subtle)] transition-colors flex items-center gap-2 sm:gap-3"
  >
    <span class="font-mono text-[var(--color-crimson)] opacity-75 text-xs font-normal select-none flex-shrink-0" aria-hidden="true">[ ? ]</span>
    <label for="search-input" class="sr-only">Search essays and dispatches</label>
    <input
      type="text"
      id="search-input"
      name="q"
      placeholder="Type query by keyword, tag, or phrase..."
      class="flex-1 min-w-0 bg-transparent border-none outline-none text-xs sm:text-sm font-mono text-[var(--color-ink)] placeholder-[var(--color-ink-faint)] tracking-wide focus:outline-none focus-visible:outline-none focus:ring-0"
      autocomplete="off"
      spellcheck="false"
      aria-controls="search-results"
    />
    <button
      type="button"
      id="search-clear-btn"
      class="hidden text-[10px] font-mono text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] cursor-pointer select-none flex-shrink-0 py-1 px-1.5 min-h-[34px] min-w-[34px] inline-flex items-center justify-center transition-colors"
      title="Clear search text"
      aria-label="Clear search input"
    >
      [ ✕ ]
    </button>
    <button
      type="submit"
      id="search-submit-btn"
      class="flex-shrink-0 font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] hover:border-[var(--color-crimson-subtle)] focus-visible:border-[var(--color-crimson-subtle)] focus-visible:text-[var(--color-crimson)] border border-[var(--color-rule)] bg-[var(--color-void)] px-2.5 sm:px-3 py-1.5 min-h-[34px] cursor-pointer transition-colors select-none inline-flex items-center justify-center gap-1.5 outline-none focus:outline-none focus:ring-0 active:scale-[0.98]"
      title="Execute search"
      aria-label="Execute search"
    >
      <span class="hidden sm:inline">SEARCH</span>
      <span class="text-[var(--color-crimson)] font-bold text-xs select-none">↵</span>
    </button>
  </form>

  <!-- Tag Filter Strip (Zine Typewriter Brackets) -->
  <div class="flex-shrink-0 px-4 sm:px-5 py-2 bg-[var(--color-void)] border-b border-[var(--color-rule)] flex items-center gap-x-2 gap-y-1 overflow-x-auto text-[11px] font-mono scrollbar-none" role="toolbar" aria-label="Popular topics">
    <span class="text-[var(--color-ink-faint)] uppercase text-[10px] tracking-widest select-none flex-shrink-0 mr-1" aria-hidden="true">
      TOPICS:
    </span>
    <div id="search-tag-chips" class="flex items-center gap-x-2 gap-y-1 flex-wrap">
      <!-- Tag buttons dynamically populated as [ #TAG ] -->
    </div>
  </div>

  <!-- Search Results Viewbox (Takes remaining height, zero jump) -->
  <div
    id="search-results"
    class="flex-1 min-h-0 overflow-y-auto px-4 sm:px-5 py-2 [scrollbar-gutter:stable]"
    role="listbox"
  >
    <!-- Default initial state: centered vertically and horizontally -->
    <div id="search-placeholder" class="h-full flex flex-col items-center justify-center py-12 text-center select-none">
      <span class="text-[var(--color-crimson)] text-xs mb-2 font-mono select-none">· · ·</span>
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-muted)] mb-1">
        Search DissidentX
      </p>
      <p class="font-serif italic text-xs text-[var(--color-ink-faint)] max-w-xs leading-relaxed">
        Query across all essays, monastic reflections, and full body texts.
      </p>
    </div>

    <!-- Live results rendered here -->
    <div id="search-items-list" class="divide-y divide-[var(--color-rule)]"></div>
  </div>

  <!-- Search Footer Bar (Matching Site Colophon) -->
  <div class="flex-shrink-0 px-4 sm:px-5 py-2.5 border-t border-[var(--color-rule)] bg-[var(--color-surface)] flex items-center justify-between text-[10px] font-mono text-[var(--color-ink-faint)] select-none tracking-wider uppercase">
    <div class="flex items-center gap-2.5 sm:gap-3">
      <span class="hidden sm:inline">[ ↑↓ ] NAVIGATE</span>
      <span class="hidden sm:inline">[ ↵ ] READ</span>
      <span>[ ESC ] CLOSE</span>
      <span class="sm:hidden text-[var(--color-ink-muted)]">· TAP TO READ</span>
    </div>
    <div class="flex items-center gap-2">
      <a
        id="search-view-all-link"
        href="/essays"
        class="hidden text-[var(--color-crimson)] hover:underline flex items-center gap-1 font-medium transition-colors cursor-pointer"
        title="Open full results in Essays archive"
      >
        <span>OPEN IN ARCHIVE</span>
        <span>→</span>
      </a>
      <span id="search-colophon-text" class="hidden sm:inline text-[var(--color-ink-faint)]">A WITNESS IN THE RUINS</span>
    </div>
  </div>
</dialog>

<style>
  #search-input,
  #search-input:focus,
  #search-input:focus-visible {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
  }

  #search-submit-btn,
  #search-submit-btn:focus,
  #search-submit-btn:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  #search-modal {
    /* Vertical positioning: centered on mobile, optical center on desktop */
    inset: 0;
    margin: auto;
    opacity: 0;
    transform: translateY(-8px) scale(0.985);
    display: none;
    flex-direction: column;

    /* Discrete transition for top-layer display and overlay */
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.22s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    transition-behavior: allow-discrete;
  }

  /* Open state */
  #search-modal[open] {
    display: flex;
    opacity: 1;
    transform: translateY(0) scale(1);

    /* Entry transition from starting style */
    @starting-style {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
  }

  /* Backdrop base / closed state */
  #search-modal::backdrop {
    background-color: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition-property: opacity, background-color, backdrop-filter, -webkit-backdrop-filter, display, overlay;
    transition-duration: 0.22s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    transition-behavior: allow-discrete;
  }

  /* Backdrop open state */
  #search-modal[open]::backdrop {
    background-color: rgba(2, 2, 2, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    @starting-style {
      background-color: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
    }
  }

  /* Explicit closing state for seamless exit */
  #search-modal.is-closing {
    opacity: 0 !important;
    transform: translateY(-6px) scale(0.985) !important;
    transition: opacity 0.16s ease-in, transform 0.16s ease-in !important;
  }

  #search-modal.is-closing::backdrop {
    background-color: rgba(0, 0, 0, 0) !important;
    backdrop-filter: blur(0px) !important;
    -webkit-backdrop-filter: blur(0px) !important;
    transition: background-color 0.16s ease-in, backdrop-filter 0.16s ease-in, -webkit-backdrop-filter 0.16s ease-in !important;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #search-modal,
    #search-modal[open],
    #search-modal::backdrop,
    #search-modal[open]::backdrop {
      transform: none !important;
      transition-duration: 0.05s !important;
    }
    @starting-style {
      #search-modal[open] {
        transform: none !important;
      }
    }
  }

  @media (min-width: 640px) {
    #search-modal {
      /* Slightly to the top of middle on desktop screens */
      top: max(3.5rem, calc(46vh - 240px));
      bottom: auto;
    }
  }
</style>

<script>
  interface SearchItem {
    id: string;
    title: string;
    description: string;
    tags: string[];
    categoryTag: string;
    date: string;
    timestamp: number;
    content: string;
  }

  interface SearchResult {
    item: SearchItem;
    score: number;
    matchLocations: string[];
    tokens: string[];
  }

  let searchData: SearchItem[] | null = null;
  let activeIndex = -1;

  const modal = document.getElementById("search-modal") as HTMLDialogElement | null;
  const searchForm = document.getElementById("search-form") as HTMLFormElement | null;
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const submitBtn = document.getElementById("search-submit-btn") as HTMLButtonElement | null;
  const clearBtn = document.getElementById("search-clear-btn");
  const closeBtn = document.getElementById("search-close-btn");
  const placeholder = document.getElementById("search-placeholder");
  const resultsContainer = document.getElementById("search-items-list");
  const tagChipsContainer = document.getElementById("search-tag-chips");
  const matchCountSpan = document.getElementById("search-match-count");
  const viewAllLink = document.getElementById("search-view-all-link") as HTMLAnchorElement | null;
  const colophonText = document.getElementById("search-colophon-text");

  function escapeHtml(str: string): string {
    if (!str) return "";
    return str.replace(/[&<>"']/g, (m) => {
      switch (m) {
        case "&": return "&amp;";
        case "<": return "&lt;";
        case ">": return "&gt;";
        case '"': return "&quot;";
        case "'": return "&#39;";
        default: return m;
      }
    });
  }

  function highlightTerms(text: string, tokens: string[]): string {
    if (!tokens || tokens.length === 0) return escapeHtml(text);
    const escapedTokens = tokens
      .filter(Boolean)
      .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
      .sort((a, b) => b.length - a.length);
    if (escapedTokens.length === 0) return escapeHtml(text);

    const regex = new RegExp(`(${escapedTokens.join("|")})`, "gi");
    const safeText = escapeHtml(text);
    return safeText.replace(
      regex,
      '<mark class="bg-[var(--color-highlight-bg)] text-[var(--color-highlight-text)] font-semibold px-0.5 rounded-none">$1</mark>'
    );
  }

  function extractSnippet(content: string, tokens: string[], maxChars = 140): string {
    if (!content) return "";
    const lowerContent = content.toLowerCase();

    let bestIdx = -1;
    let matchedTok = "";
    for (const tok of tokens) {
      const idx = lowerContent.indexOf(tok);
      if (idx !== -1 && (bestIdx === -1 || idx < bestIdx)) {
        bestIdx = idx;
        matchedTok = tok;
      }
    }

    if (bestIdx === -1) {
      const slice = content.slice(0, maxChars);
      return highlightTerms(slice + (content.length > maxChars ? "..." : ""), tokens);
    }

    const start = Math.max(0, bestIdx - 45);
    const end = Math.min(content.length, bestIdx + matchedTok.length + 80);
    let snippet = content.slice(start, end);

    if (start > 0) {
      const firstSpace = snippet.indexOf(" ");
      if (firstSpace !== -1 && firstSpace < 15) {
        snippet = snippet.slice(firstSpace + 1);
      }
      snippet = "..." + snippet;
    }
    if (end < content.length) {
      const lastSpace = snippet.lastIndexOf(" ");
      if (lastSpace !== -1 && lastSpace > snippet.length - 15) {
        snippet = snippet.slice(0, lastSpace);
      }
      snippet = snippet + "...";
    }

    return highlightTerms(snippet, tokens);
  }

  function searchDocuments(docs: SearchItem[], query: string): SearchResult[] {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    const tokens = q.split(/\s+/).filter(Boolean);
    if (tokens.length === 0) return [];

    const results: SearchResult[] = [];

    for (const doc of docs) {
      const titleLower = (doc.title || "").toLowerCase();
      const descLower = (doc.description || "").toLowerCase();
      const tagsLower = (doc.tags || []).map((t) => t.toLowerCase());
      const contentLower = (doc.content || "").toLowerCase();

      // Strict AND evaluation: every token must exist in the essay
      const matchesAll = tokens.every(
        (tok) =>
          titleLower.includes(tok) ||
          descLower.includes(tok) ||
          tagsLower.some((t) => t.includes(tok)) ||
          contentLower.includes(tok)
      );

      if (!matchesAll) continue;

      let score = 0;
      const matchLocations = new Set<string>();

      // Full query match bonuses
      if (titleLower.includes(q)) {
        score += 100;
        matchLocations.add("TITLE");
      }
      if (tagsLower.some((t) => t.includes(q))) {
        score += 60;
        matchLocations.add("TOPICS");
      }
      if (descLower.includes(q)) {
        score += 40;
        matchLocations.add("EXCERPT");
      }
      if (contentLower.includes(q)) {
        score += 20;
        matchLocations.add("BODY TEXT");
      }

      // Individual token scoring
      tokens.forEach((tok) => {
        if (titleLower.includes(tok)) {
          score += 30;
          matchLocations.add("TITLE");
        }
        if (tagsLower.some((t) => t.includes(tok))) {
          score += 20;
          matchLocations.add("TOPICS");
        }
        if (descLower.includes(tok)) {
          score += 15;
          matchLocations.add("EXCERPT");
        }
        if (contentLower.includes(tok)) {
          score += 5;
          matchLocations.add("BODY TEXT");
        }
      });

      results.push({
        item: doc,
        score,
        matchLocations: Array.from(matchLocations),
        tokens,
      });
    }

    return results.sort((a, b) => b.score - a.score);
  }

  // Load index data lazily
  async function loadSearchIndex() {
    if (searchData) return;
    try {
      const res = await fetch("/search-index.json");
      if (!res.ok) throw new Error("Failed to load search index");
      searchData = await res.json();

      if (searchData) {
        populateTagChips(searchData);
      }
    } catch (err) {
      console.error("Search index error:", err);
    }
  }

  function populateTagChips(items: SearchItem[]) {
    if (!tagChipsContainer) return;
    const allTags = Array.from(new Set(items.flatMap((item) => item.tags || []))).slice(0, 8);
    tagChipsContainer.innerHTML = "";

    allTags.forEach((tag) => {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className =
        "text-[10px] font-mono uppercase text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] transition-colors cursor-pointer select-none py-1.5 px-2 min-h-[36px] leading-tight inline-flex items-center";
      chip.textContent = `[ #${tag} ]`;
      chip.setAttribute("aria-label", `Filter by tag ${tag}`);
      chip.addEventListener("click", () => {
        if (!input) return;
        input.value = tag;
        performSearch(tag);
        input.focus();
      });
      tagChipsContainer.appendChild(chip);
    });
  }

  let isClosing = false;
  let closeTimeout: ReturnType<typeof setTimeout> | null = null;

  function openSearch(initialQuery = "") {
    if (!modal) return;
    if (modal.open && !isClosing) return;

    if (isClosing) {
      if (closeTimeout) clearTimeout(closeTimeout);
      isClosing = false;
      modal.classList.remove("is-closing");
    }

    modal.showModal();
    document.body.classList.add("overflow-hidden");

    // Eagerly focus without causing browser to jump or scroll the page
    if (input) {
      input.focus({ preventScroll: true });
      if (initialQuery) {
        input.value = initialQuery;
      }
    }

    loadSearchIndex().then(() => {
      if (initialQuery) {
        performSearch(initialQuery);
      }
    });
  }

  function closeSearch() {
    if (!modal || !modal.open || isClosing) return;
    isClosing = true;

    modal.classList.add("is-closing");

    closeTimeout = setTimeout(() => {
      if (!modal.open) return;
      modal.close();
      modal.classList.remove("is-closing");
      document.body.classList.remove("overflow-hidden");
      isClosing = false;
      if (input) input.value = "";
      if (clearBtn) clearBtn.classList.add("hidden");
      if (resultsContainer) resultsContainer.innerHTML = "";
      if (placeholder) placeholder.style.display = "flex";
      if (matchCountSpan) matchCountSpan.textContent = "READY";
      if (viewAllLink) viewAllLink.classList.add("hidden");
      if (colophonText) colophonText.classList.remove("hidden");
      activeIndex = -1;
    }, 180);
  }

  function performSearch(query: string) {
    if (!resultsContainer || !placeholder || !matchCountSpan) return;

    const trimmed = query.trim();
    if (clearBtn) {
      clearBtn.classList.toggle("hidden", !trimmed);
    }

    if (!trimmed) {
      resultsContainer.innerHTML = "";
      placeholder.style.display = "flex";
      matchCountSpan.textContent = "READY";
      activeIndex = -1;
      if (viewAllLink) viewAllLink.classList.add("hidden");
      if (colophonText) colophonText.classList.remove("hidden");
      return;
    }

    placeholder.style.display = "none";
    if (viewAllLink) {
      viewAllLink.href = `/essays?q=${encodeURIComponent(trimmed)}`;
      viewAllLink.classList.remove("hidden");
      if (colophonText) colophonText.classList.add("hidden");
    }

    if (!searchData) {
      resultsContainer.innerHTML = `<div class="h-full flex items-center justify-center font-mono text-xs text-[var(--color-ink-muted)] py-8">INDEXING ARCHIVE...</div>`;
      return;
    }

    const results = searchDocuments(searchData, trimmed);
    resultsContainer.innerHTML = "";
    activeIndex = -1;

    if (results.length === 0) {
      matchCountSpan.textContent = "0 MATCHES FOUND";
      resultsContainer.innerHTML = `
        <div class="h-full flex flex-col items-center justify-center py-16 text-center select-none">
          <span class="text-[var(--color-crimson)] text-xs mb-2 font-mono">✕</span>
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-bright)] mb-1.5">No dispatches found</p>
          <p class="font-serif italic text-xs text-[var(--color-ink-muted)] max-w-xs leading-relaxed mb-4">
            No writings match "${escapeHtml(trimmed)}". Try searching by tag or broader keywords.
          </p>
          <a
            href="/essays?q=${encodeURIComponent(trimmed)}"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-[var(--color-rule)] text-[var(--color-crimson)] hover:border-[var(--color-crimson)] font-mono text-xs uppercase tracking-wider transition-colors no-underline cursor-pointer"
          >
            Open in Essays Archive →
          </a>
        </div>
      `;
      return;
    }

    matchCountSpan.textContent = `FOUND ${results.length} ${results.length === 1 ? "DISPATCH" : "DISPATCHES"}`;

    results.forEach((res, idx) => {
      const item = res.item;
      const highlightedTitle = highlightTerms(item.title, res.tokens);
      const highlightedDesc = highlightTerms(item.description, res.tokens);
      const snippet = extractSnippet(item.content, res.tokens);

      const card = document.createElement("a");
      card.href = `/essays/${item.id}`;
      card.className =
        "search-result-item block py-3.5 px-3 -mx-3 border-b border-[var(--color-rule)] text-left no-underline transition-all group hover:bg-[var(--color-surface-hover)] focus:outline-none focus:bg-[var(--color-surface-hover)]";
      card.setAttribute("data-index", String(idx));
      card.setAttribute("role", "option");
      card.setAttribute("aria-selected", "false");
      card.addEventListener("click", () => {
        closeSearch();
      });

      const locationBadge = res.matchLocations.length > 0
        ? `<span class="text-[9px] font-mono tracking-wider uppercase text-[var(--color-highlight-text)] bg-[var(--color-highlight-bg)] px-1.5 py-0.5 border border-[var(--color-highlight-border)]">MATCHED IN: ${res.matchLocations.join(" & ")}</span>`
        : "";

      card.innerHTML = `
        <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-[var(--color-ink-faint)] mb-1.5">
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-crimson)] font-medium">${item.categoryTag || "Essay"}</span>
            <span class="text-[var(--color-ink-faint)]">·</span>
            <time>${item.date}</time>
          </div>
          ${locationBadge}
        </div>
        <h4 class="font-serif text-base sm:text-lg font-bold text-[var(--color-ink)] group-hover:text-[var(--color-crimson)] transition-colors mb-1 vhs-chromatic-hover">
          ${highlightedTitle}
        </h4>
        <p class="font-serif text-xs sm:text-sm text-[var(--color-ink-muted)] line-clamp-2 leading-relaxed mb-2">
          ${highlightedDesc}
        </p>
        ${
          snippet
            ? `<div class="text-[11px] font-mono text-[var(--color-ink-muted)] bg-[var(--color-void)] pl-3 pr-2 py-1.5 border-l-2 border-[var(--color-highlight-border)] my-2 line-clamp-2 leading-relaxed">
                <span class="text-[9px] uppercase tracking-wider text-[var(--color-ink-faint)] block mb-0.5 select-none font-sans">EXCERPT:</span>
                ${snippet}
              </div>`
            : ""
        }
        ${
          item.tags && item.tags.length > 0
            ? `<div class="flex items-center gap-2 mt-2">
                ${item.tags
                  .map(
                    (t) =>
                      `<span class="text-[10px] font-mono text-[var(--color-ink-faint)] group-hover:text-[var(--color-ink-muted)] transition-colors">#${highlightTerms(t, res.tokens)}</span>`
                  )
                  .join(" ")}
              </div>`
            : ""
        }
      `;

      resultsContainer.appendChild(card);
    });

    // Deep link row to open full archive query
    const archiveRow = document.createElement("a");
    archiveRow.href = `/essays?q=${encodeURIComponent(trimmed)}`;
    archiveRow.className =
      "search-result-item block py-3.5 my-2 text-center no-underline border border-[var(--color-rule)] bg-[var(--color-void)] hover:border-[var(--color-crimson)] transition-colors group focus:outline-none focus:bg-[var(--color-surface-hover)]";
    archiveRow.setAttribute("data-index", String(results.length));
    archiveRow.setAttribute("role", "option");
    archiveRow.setAttribute("aria-selected", "false");
    archiveRow.addEventListener("click", () => {
      closeSearch();
    });
    archiveRow.innerHTML = `
      <span class="text-xs font-mono tracking-wider text-[var(--color-crimson)] group-hover:underline">
        [ ↵ VIEW ALL ${results.length} ${results.length === 1 ? "RESULT" : "RESULTS"} IN ARCHIVE → ]
      </span>
    `;
    resultsContainer.appendChild(archiveRow);
  }

  function updateActiveSelection(newIndex: number) {
    const items = resultsContainer?.querySelectorAll<HTMLElement>(".search-result-item");
    if (!items || items.length === 0) return;

    items.forEach((it) => {
      it.classList.remove("bg-[var(--color-surface-hover)]", "pl-2", "border-l-2", "border-l-[var(--color-crimson)]");
      it.setAttribute("aria-selected", "false");
    });

    if (newIndex >= 0 && newIndex < items.length) {
      activeIndex = newIndex;
      const target = items[activeIndex];
      target.classList.add("bg-[var(--color-surface-hover)]", "pl-2", "border-l-2", "border-l-[var(--color-crimson)]");
      target.setAttribute("aria-selected", "true");
      target.scrollIntoView({ block: "nearest" });
    }
  }

  // Live filtering on input
  input?.addEventListener("input", (e) => {
    performSearch((e.target as HTMLInputElement).value);
  });

  // Seamlessly fade button into inactive state after clicking/tapping
  const handleButtonRelease = () => {
    setTimeout(() => {
      submitBtn?.blur();
    }, 80);
  };

  submitBtn?.addEventListener("pointerup", handleButtonRelease);
  submitBtn?.addEventListener("touchend", handleButtonRelease);

  // Explicit form submission via [ SEARCH ↵ ] or pressing Enter
  searchForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    handleButtonRelease();
    const items = resultsContainer?.querySelectorAll<HTMLElement>(".search-result-item");
    if (items && activeIndex >= 0 && activeIndex < items.length) {
      (items[activeIndex] as HTMLAnchorElement).click();
      return;
    }
    const query = input?.value.trim();
    if (query) {
      closeSearch();
      window.location.href = `/essays?q=${encodeURIComponent(query)}`;
    }
  });

  // Clear button resets search
  clearBtn?.addEventListener("click", () => {
    if (!input) return;
    input.value = "";
    performSearch("");
    input.focus();
  });

  // Arrow key navigation
  input?.addEventListener("keydown", (e) => {
    const items = resultsContainer?.querySelectorAll<HTMLElement>(".search-result-item");

    if (e.key === "ArrowDown" && items && items.length > 0) {
      e.preventDefault();
      const next = activeIndex + 1 < items.length ? activeIndex + 1 : 0;
      updateActiveSelection(next);
    } else if (e.key === "ArrowUp" && items && items.length > 0) {
      e.preventDefault();
      const prev = activeIndex - 1 >= 0 ? activeIndex - 1 : items.length - 1;
      updateActiveSelection(prev);
    }
  });

  closeBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    closeSearch();
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeSearch();
    }
  });

  // Intercept native dialog cancel on Escape to run smooth exit transition
  modal?.addEventListener("cancel", (e) => {
    e.preventDefault();
    closeSearch();
  });

  // Global hotkeys: '/' or 'Cmd+K' / 'Ctrl+K'
  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    const isTyping =
      target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);

    if (e.key === "/" && !isTyping) {
      e.preventDefault();
      openSearch();
    } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (modal?.open) {
        closeSearch();
      } else {
        openSearch();
      }
    } else if (e.key === "Escape" && modal?.open) {
      closeSearch();
    }
  });

  // Custom event trigger for buttons on the page
  window.addEventListener("dissidentx:open-search", (e: any) => {
    openSearch(e?.detail?.query || "");
  });

  document.addEventListener("astro:before-preparation", () => {
    if (modal?.open) {
      modal.close();
      document.body.classList.remove("overflow-hidden");
    }
  });
</script>
