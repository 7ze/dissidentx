---
---

<canvas id="vhs-particles" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true" transition:persist></canvas>

<script>
  function initParticles() {
    const canvas = document.getElementById("vhs-particles") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    // Full atmospheric density: 1,400 particles across the screen
    const PARTICLE_COUNT = 1400;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      depth: number;
    }

    // Fixed static buckets (zero allocations per frame):
    const faintParticles: Particle[] = [];
    const midParticles: Particle[] = [];
    const brightParticles: Particle[] = [];
    const crimsonParticles: Particle[] = [];
    const allParticles: Particle[] = [];

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const isCrimson = Math.random() < 0.10;
      const speedTier = Math.random();
      const speedMultiplier = speedTier < 0.75 ? 0.16 : 0.26;
      const depth = speedTier < 0.75 ? 0.08 : 0.18;

      const p: Particle = {
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * speedMultiplier,
        vy: (Math.random() - 0.5) * speedMultiplier,
        r: Math.random() < 0.80 ? Math.random() * 0.35 + 0.3 : Math.random() * 0.4 + 0.7,
        depth,
      };

      allParticles.push(p);

      if (isCrimson) {
        crimsonParticles.push(p);
      } else {
        const tier = Math.random();
        if (tier < 0.45) {
          faintParticles.push(p);
        } else if (tier < 0.80) {
          midParticles.push(p);
        } else {
          brightParticles.push(p);
        }
      }
    }

    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;

    window.addEventListener("scroll", () => {
      if (prefersReducedMotion) return;
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;
      lastScrollY = currentY;
      scrollVelocity = Math.max(-20, Math.min(20, scrollVelocity + delta * 0.35));
    }, { passive: true });

    let isLight = document.documentElement.getAttribute("data-theme") === "light";

    let animId: number | null = null;
    let isLoopRunning = false;

    function render(_time: number) {
      if (!ctx) return;

      ctx.clearRect(0, 0, width, height);

      // Update particle positions in-place
      if (!prefersReducedMotion) {
        for (let i = 0; i < allParticles.length; i++) {
          const p = allParticles[i];
          p.x += p.vx;
          p.y += p.vy - scrollVelocity * p.depth;

          // Wrap smoothly across screen bounds
          if (p.x < -10) p.x = width + 10;
          else if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          else if (p.y > height + 10) p.y = -10;
        }
      }

      // Draw tiers using pure immediate-mode Canvas2D (zero object allocations, zero memory leak):
      // 1. Faint tier
      ctx.fillStyle = isLight ? "rgba(55, 45, 36, 0.12)" : "rgba(230, 226, 218, 0.08)";
      ctx.beginPath();
      for (let i = 0; i < faintParticles.length; i++) {
        const p = faintParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 2. Mid tier
      ctx.fillStyle = isLight ? "rgba(45, 36, 28, 0.22)" : "rgba(230, 226, 218, 0.15)";
      ctx.beginPath();
      for (let i = 0; i < midParticles.length; i++) {
        const p = midParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 3. Bright tier
      ctx.fillStyle = isLight ? "rgba(35, 26, 18, 0.35)" : "rgba(230, 226, 218, 0.24)";
      ctx.beginPath();
      for (let i = 0; i < brightParticles.length; i++) {
        const p = brightParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 4. Crimson tier
      ctx.fillStyle = isLight ? "rgba(200, 16, 46, 0.36)" : "rgba(200, 16, 46, 0.22)";
      ctx.beginPath();
      for (let i = 0; i < crimsonParticles.length; i++) {
        const p = crimsonParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      if (!prefersReducedMotion) {
        scrollVelocity *= 0.88;
        animId = requestAnimationFrame(render);
      }
    }

    function startLoop() {
      if (isLoopRunning || prefersReducedMotion || document.hidden) return;
      isLoopRunning = true;
      animId = requestAnimationFrame(render);
    }

    function stopLoop() {
      if (animId !== null) {
        cancelAnimationFrame(animId);
        animId = null;
      }
      isLoopRunning = false;
    }

    // Stop loop immediately when tab is hidden / backgrounded
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopLoop();
      } else {
        startLoop();
      }
    });

    // Handle canvas context lost / restored (sleep mode / GPU power management)
    canvas.addEventListener("contextlost", (e) => {
      e.preventDefault();
      stopLoop();
    });
    canvas.addEventListener("contextrestored", () => {
      startLoop();
    });

    window.addEventListener("dissidentx:theme-change", (e: any) => {
      isLight = e.detail?.theme === "light";
      if (prefersReducedMotion) render(0);
    });

    document.addEventListener("astro:after-swap", () => {
      isLight = document.documentElement.getAttribute("data-theme") === "light";
      if (prefersReducedMotion) render(0);
    });

    if (prefersReducedMotion) {
      render(0);
    } else {
      startLoop();
    }

    let resizeTimer: number;
    const handleResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        if (prefersReducedMotion) render(0);
      }, 150);
    };

    window.addEventListener("resize", handleResize, { passive: true });
  }

  let initialized = false;
  function startParticles() {
    if (initialized) return;
    initParticles();
    initialized = true;
  }

  // Initialize on page load
  startParticles();
  document.addEventListener("astro:page-load", startParticles);
</script>
