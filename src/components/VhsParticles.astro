---
---

<canvas id="vhs-particles" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true" transition:persist></canvas>

<script>
  function initParticles() {
    const canvas = document.getElementById("vhs-particles") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    // Adaptive atmospheric density: Higher density on mobile (~750) and elevated on wide desktop (up to 2,500)
    const PARTICLE_COUNT = Math.min(2500, Math.max(750, Math.floor((width * height) / 520)));

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      depth: number;
      isCrimson: boolean;
      twinkleOffset: number;
      twinkleInterval: number;
    }

    // Fixed static buckets (zero allocations per frame):
    const faintParticles: Particle[] = [];
    const midParticles: Particle[] = [];
    const brightParticles: Particle[] = [];
    const crimsonParticles: Particle[] = [];
    const allParticles: Particle[] = [];
    const twinkleParticles: Particle[] = [];

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const isCrimson = Math.random() < 0.10;
      const speedTier = Math.random();
      const speedMultiplier = speedTier < 0.75 ? 0.16 : 0.26;
      const depth = speedTier < 0.75 ? 0.08 : 0.18;

      // Rare candidates (~2.5% of particles, ~35 across the entire viewport)
      const isTwinkler = Math.random() < 0.025;

      const p: Particle = {
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * speedMultiplier,
        vy: (Math.random() - 0.5) * speedMultiplier,
        r: Math.random() < 0.80 ? Math.random() * 0.35 + 0.3 : Math.random() * 0.4 + 0.7,
        depth,
        isCrimson,
        twinkleOffset: Math.random() * 20000,
        twinkleInterval: Math.random() * 7000 + 8000, // 8s to 15s interval between blooms
      };

      allParticles.push(p);
      if (isTwinkler) {
        twinkleParticles.push(p);
      }

      if (isCrimson) {
        crimsonParticles.push(p);
      } else {
        const tier = Math.random();
        if (tier < 0.45) {
          faintParticles.push(p);
        } else if (tier < 0.80) {
          midParticles.push(p);
        } else {
          brightParticles.push(p);
        }
      }
    }

    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;

    let lastActivityTime = performance.now();
    function onUserActivity() {
      lastActivityTime = performance.now();
    }
    window.addEventListener("mousemove", onUserActivity, { passive: true });
    window.addEventListener("keydown", onUserActivity, { passive: true });
    window.addEventListener("touchstart", onUserActivity, { passive: true });

    window.addEventListener("scroll", () => {
      onUserActivity();
      if (prefersReducedMotion) return;
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;
      lastScrollY = currentY;
      scrollVelocity = Math.max(-20, Math.min(20, scrollVelocity + delta * 0.35));
    }, { passive: true });

    let isLight = document.documentElement.getAttribute("data-theme") === "light";

    let animId: number | null = null;
    let isLoopRunning = false;
    let lastFrameTime = 0;

    function render(time: number) {
      if (!ctx) return;
      if (document.hidden) {
        stopLoop();
        return;
      }

      // Inactivity power-saver: 30 FPS when idle for > 60s, smooth 60 FPS when active
      // Also prevents excessive 120Hz/144Hz/240Hz battery drain on ProMotion/gaming screens
      const isIdle = time - lastActivityTime > 60000;
      const targetInterval = isIdle ? 33 : 16;

      const elapsed = time - lastFrameTime;
      if (lastFrameTime > 0 && elapsed < targetInterval - 1) {
        if (!prefersReducedMotion) {
          animId = requestAnimationFrame(render);
        }
        return;
      }

      // Delta time normalized to 60fps (16.66ms) so particle drift speed is identical on all screens
      const dt = lastFrameTime === 0 ? 1 : Math.min(2.0, elapsed / 16.66);
      lastFrameTime = time;

      ctx.clearRect(0, 0, width, height);

      // Update particle positions in-place
      if (!prefersReducedMotion) {
        for (let i = 0; i < allParticles.length; i++) {
          const p = allParticles[i];
          p.x += p.vx * dt;
          p.y += (p.vy - scrollVelocity * p.depth) * dt;

          // Wrap smoothly across screen bounds
          if (p.x < -10) p.x = width + 10;
          else if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          else if (p.y > height + 10) p.y = -10;
        }
      }

      ctx.globalAlpha = 1.0;

      // Draw tiers using pure immediate-mode Canvas2D (zero object allocations, zero memory leak):
      // 1. Faint tier
      ctx.fillStyle = isLight ? "rgba(55, 45, 36, 0.12)" : "rgba(230, 226, 218, 0.08)";
      ctx.beginPath();
      for (let i = 0; i < faintParticles.length; i++) {
        const p = faintParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 2. Mid tier
      ctx.fillStyle = isLight ? "rgba(45, 36, 28, 0.22)" : "rgba(230, 226, 218, 0.15)";
      ctx.beginPath();
      for (let i = 0; i < midParticles.length; i++) {
        const p = midParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 3. Bright tier
      ctx.fillStyle = isLight ? "rgba(35, 26, 18, 0.35)" : "rgba(230, 226, 218, 0.24)";
      ctx.beginPath();
      for (let i = 0; i < brightParticles.length; i++) {
        const p = brightParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 4. Crimson tier
      ctx.fillStyle = isLight ? "rgba(200, 16, 46, 0.36)" : "rgba(200, 16, 46, 0.22)";
      ctx.beginPath();
      for (let i = 0; i < crimsonParticles.length; i++) {
        const p = crimsonParticles[i];
        const radius = isLight ? Math.max(p.r, 0.42) : p.r;
        ctx.moveTo(p.x + radius, p.y);
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      }
      ctx.fill();

      // 5. Ultra-subtle Micro-Twinkle: Stellar Star in Dark Mode / Red Accent Glow in Light Mode
      // Zero string allocations: Uses static constant color strings + ctx.globalAlpha
      if (!prefersReducedMotion && time > 0) {
        const BLOOM_DURATION = 800; // Crisp, gentle 800ms swell
        for (let i = 0; i < twinkleParticles.length; i++) {
          const p = twinkleParticles[i];
          const cycle = (time + p.twinkleOffset) % p.twinkleInterval;
          if (cycle < BLOOM_DURATION) {
            const progress = cycle / BLOOM_DURATION;
            const swell = Math.sin(progress * Math.PI); // Organic 0 -> 1 -> 0 bell-curve

            // Uniform geometry and swell across both dark and light modes
            const haloRadius = p.r * 1.4 + swell * 0.9;
            const haloAlpha = swell * 0.16;
            const coreRadius = p.r + swell * 0.22;
            const coreAlpha = swell * 0.80;

            // Layer 1: Soft radiant corona (Dark mode: cool starlight / Light mode: subtle crimson accent)
            ctx.globalAlpha = haloAlpha;
            ctx.fillStyle = isLight
              ? (p.isCrimson ? "rgb(175, 12, 35)" : "rgb(200, 16, 46)")
              : (p.isCrimson ? "rgb(220, 20, 50)" : "rgb(215, 230, 255)");
            ctx.beginPath();
            ctx.arc(p.x, p.y, haloRadius, 0, Math.PI * 2);
            ctx.fill();

            // Layer 2: Pinpoint core (Dark mode: crisp white star / Light mode: crimson accent)
            ctx.globalAlpha = coreAlpha;
            ctx.fillStyle = isLight
              ? (p.isCrimson ? "rgb(160, 10, 30)" : "rgb(190, 16, 42)")
              : (p.isCrimson ? "rgb(255, 90, 110)" : "rgb(255, 255, 255)");
            ctx.beginPath();
            ctx.arc(p.x, p.y, coreRadius, 0, Math.PI * 2);
            ctx.fill();

            // Layer 3: Micro-glint ray (uniform threshold, dimensions, and stroke width)
            const rayThreshold = 0.65;
            if (swell > rayThreshold) {
              const rayStrength = (swell - rayThreshold) / (1 - rayThreshold);
              const rayLen = 1.0 + rayStrength * 1.5;
              ctx.globalAlpha = rayStrength * 0.30;
              ctx.strokeStyle = isLight
                ? (p.isCrimson ? "rgb(160, 10, 30)" : "rgb(190, 16, 42)")
                : (p.isCrimson ? "rgb(255, 80, 100)" : "rgb(255, 255, 255)");
              ctx.lineWidth = 0.6;

              ctx.beginPath();
              // Horizontal micro-glint
              ctx.moveTo(p.x - rayLen, p.y);
              ctx.lineTo(p.x + rayLen, p.y);
              // Vertical micro-glint
              ctx.moveTo(p.x, p.y - rayLen);
              ctx.lineTo(p.x, p.y + rayLen);
              ctx.stroke();
            }
          }
        }
        ctx.globalAlpha = 1.0;
      }

      if (!prefersReducedMotion) {
        scrollVelocity *= Math.pow(0.88, dt);
        animId = requestAnimationFrame(render);
      }
    }

    function startLoop() {
      if (isLoopRunning || prefersReducedMotion || document.hidden) return;
      isLoopRunning = true;
      lastFrameTime = 0;
      animId = requestAnimationFrame(render);
    }

    function stopLoop() {
      if (animId !== null) {
        cancelAnimationFrame(animId);
        animId = null;
      }
      isLoopRunning = false;
    }

    // Stop loop immediately when tab is hidden / backgrounded
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopLoop();
      } else {
        startLoop();
      }
    });

    // Handle canvas context lost / restored (sleep mode / GPU power management)
    canvas.addEventListener("contextlost", (e) => {
      e.preventDefault();
      stopLoop();
    });
    canvas.addEventListener("contextrestored", () => {
      startLoop();
    });

    window.addEventListener("dissidentx:theme-change", (e: any) => {
      isLight = e.detail?.theme === "light";
      if (prefersReducedMotion) render(0);
    });

    document.addEventListener("astro:after-swap", () => {
      isLight = document.documentElement.getAttribute("data-theme") === "light";
      if (prefersReducedMotion) render(0);
    });

    if (prefersReducedMotion) {
      render(0);
    } else {
      startLoop();
    }

    let resizeTimer: number;
    const handleResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        if (prefersReducedMotion) render(0);
      }, 150);
    };

    window.addEventListener("resize", handleResize, { passive: true });
  }

  let initialized = false;
  function startParticles() {
    if (initialized) return;
    initParticles();
    initialized = true;
  }

  // Initialize on page load
  startParticles();
  document.addEventListener("astro:page-load", startParticles);
</script>
