---
interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id = "vhs-tympanum-headpiece" } = Astro.props;
---

<div id={id} class={`w-full max-w-xl mx-auto overflow-hidden pointer-events-none select-none ${className}`} aria-hidden="true">
  <svg
    viewBox="0 0 800 280"
    class="w-full h-auto text-[var(--color-ornament-line)] opacity-85 transition-opacity duration-300"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- CROWNING FINIAL AT APEX -->
    <g id="apex-finial" transform="translate(400, 18)" stroke="currentColor" stroke-width="1.1" fill="none">
      <path d="M 0,-12 L 0,8 M -7,-3 C -7,-8 0,-10 0,-12 C 0,-10 7,-8 7,-3 C 5,2 0,4 0,8" />
      <circle cx="0" cy="-3" r="2" fill="var(--color-ornament-crimson)" stroke="none" />
      <path d="M -5,-3 C -10,-2 -11,-7 -8,-9 C -5,-8 -4,-5 -5,-3 Z" />
      <path d="M 5,-3 C 10,-2 11,-7 8,-9 C 5,-8 4,-5 5,-3 Z" />
    </g>

    <!-- CONCENTRIC GOTHIC ARCH MOLDINGS -->
    <path
      d="M 40,260 L 120,260 C 170,210 260,110 400,26 C 540,110 630,210 680,260 L 760,260"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <path
      d="M 55,260 L 130,260 C 178,212 265,115 400,34 C 535,115 622,212 670,260 L 745,260"
      fill="none"
      stroke="currentColor"
      stroke-width="0.8"
      stroke-dasharray="2 3"
    />
    <path
      d="M 70,260 L 140,260 C 185,215 270,120 400,42 C 530,120 615,215 660,260 L 730,260"
      fill="none"
      stroke="currentColor"
      stroke-width="1.1"
    />
    <path
      d="M 90,260 L 155,260 C 198,218 278,128 400,52 C 522,128 602,218 645,260 L 710,260"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
    />

    <!-- Plinth Baseline -->
    <line x1="20" y1="260" x2="780" y2="260" stroke="currentColor" stroke-width="1.8" />
    <line x1="30" y1="266" x2="770" y2="266" stroke="currentColor" stroke-width="0.8" stroke-dasharray="3 3" />
    <line x1="15" y1="272" x2="785" y2="272" stroke="currentColor" stroke-width="1.4" />

    <!-- SPANDREL TREFOILS -->
    <g id="spandrel-left" transform="translate(230, 115)" stroke="currentColor" stroke-width="0.9" fill="none">
      <circle cx="0" cy="0" r="18" />
      <circle cx="0" cy="0" r="21" stroke-dasharray="2 2" stroke-width="0.6" />
      <circle cx="-6" cy="4" r="7" />
      <circle cx="6" cy="4" r="7" />
      <circle cx="0" cy="-7" r="7" />
      <circle cx="0" cy="0" r="2" fill="var(--color-ornament-gold)" stroke="none" />
    </g>

    <g id="spandrel-right" transform="translate(570, 115)" stroke="currentColor" stroke-width="0.9" fill="none">
      <circle cx="0" cy="0" r="18" />
      <circle cx="0" cy="0" r="21" stroke-dasharray="2 2" stroke-width="0.6" />
      <circle cx="-6" cy="4" r="7" />
      <circle cx="6" cy="4" r="7" />
      <circle cx="0" cy="-7" r="7" />
      <circle cx="0" cy="0" r="2" fill="var(--color-ornament-gold)" stroke="none" />
    </g>

    <!-- INNER GOTHIC TREFOIL APEX CUSPS -->
    <path
      d="M 310,140 C 325,95 365,95 378,112 C 388,85 412,85 422,112 C 435,95 475,95 490,140"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
    />
    <circle cx="350" cy="98" r="3.5" fill="none" stroke="currentColor" stroke-width="0.9" />
    <circle cx="450" cy="98" r="3.5" fill="none" stroke="currentColor" stroke-width="0.9" />
    <circle cx="400" cy="74" r="5" fill="none" stroke="currentColor" stroke-width="1.0" />
    <circle cx="400" cy="74" r="2" fill="var(--color-ornament-crimson)" stroke="none" />

    <!-- RADIANT STARBURST (48 Needle Rays) -->
    <g id="grail-radiance" stroke="var(--color-ornament-gold)" stroke-width="0.85" opacity="0.85">
      <circle cx="400" cy="145" r="58" fill="none" stroke-width="0.6" stroke-dasharray="3 3" />
      <circle cx="400" cy="145" r="46" fill="none" stroke-width="0.5" />
      <circle cx="400" cy="145" r="42" fill="none" stroke-width="0.5" stroke-dasharray="2 2" />

      <!-- Cardinal Rays -->
      <line x1="400" y1="145" x2="400" y2="76" stroke-width="1.0" />
      <line x1="400" y1="145" x2="400" y2="214" stroke-width="1.0" />
      <line x1="400" y1="145" x2="331" y2="145" stroke-width="1.0" />
      <line x1="400" y1="145" x2="469" y2="145" stroke-width="1.0" />
      <line x1="400" y1="145" x2="351" y2="96" stroke-width="1.0" />
      <line x1="400" y1="145" x2="449" y2="96" stroke-width="1.0" />
      <line x1="400" y1="145" x2="351" y2="194" stroke-width="1.0" />
      <line x1="400" y1="145" x2="449" y2="194" stroke-width="1.0" />

      <!-- Intermediate Rays -->
      <line x1="400" y1="145" x2="375" y2="84" stroke-width="0.7" />
      <line x1="400" y1="145" x2="425" y2="84" stroke-width="0.7" />
      <line x1="400" y1="145" x2="375" y2="206" stroke-width="0.7" />
      <line x1="400" y1="145" x2="425" y2="206" stroke-width="0.7" />
      <line x1="400" y1="145" x2="339" y2="120" stroke-width="0.7" />
      <line x1="400" y1="145" x2="461" y2="120" stroke-width="0.7" />
      <line x1="400" y1="145" x2="339" y2="170" stroke-width="0.7" />
      <line x1="400" y1="145" x2="461" y2="170" stroke-width="0.7" />

      <!-- Needle Stipples -->
      <line x1="400" y1="145" x2="362" y2="92" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="438" y2="92" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="362" y2="198" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="438" y2="198" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="347" y2="133" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="453" y2="133" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="347" y2="157" stroke-dasharray="2 3" stroke-width="0.5" />
      <line x1="400" y1="145" x2="453" y2="157" stroke-dasharray="2 3" stroke-width="0.5" />
    </g>

    <!-- THE HOLY GRAIL -->
    <g id="holy-grail" stroke="currentColor" fill="none">
      <ellipse cx="400" cy="116" rx="24" ry="4.5" stroke-width="1.4" />
      <ellipse cx="400" cy="118" rx="22" ry="3.8" stroke-width="0.7" stroke-dasharray="1.5 1.5" />
      <path d="M 376,116 C 376,150 400,160 400,160 C 400,160 424,150 424,116" stroke-width="1.5" />
      <path d="M 384,119 C 386,142 394,155 400,160" stroke-width="0.9" />
      <path d="M 416,119 C 414,142 406,155 400,160" stroke-width="0.9" />
      <path d="M 392,120 C 393,144 397,157 400,160" stroke-width="0.7" stroke-dasharray="2 2" />
      <path d="M 408,120 C 407,144 403,157 400,160" stroke-width="0.7" stroke-dasharray="2 2" />
      <line x1="400" y1="120" x2="400" y2="160" stroke-width="1.0" />
      <path d="M 377,126 C 388,131 412,131 423,126" stroke-width="0.8" />
      <path d="M 378,130 C 388,135 412,135 422,130" stroke-width="0.8" />

      <!-- Stem & Knop -->
      <line x1="397" y1="160" x2="397" y2="186" stroke-width="1.2" />
      <line x1="403" y1="160" x2="403" y2="186" stroke-width="1.2" />
      <ellipse cx="400" cy="173" rx="8" ry="4.5" stroke-width="1.3" />
      <path d="M 392,173 L 400,169 L 408,173 L 400,177 Z" stroke-width="0.9" />
      <circle cx="400" cy="173" r="2.4" fill="var(--color-ornament-crimson)" stroke="none" />

      <!-- Stepped Sexfoil Base -->
      <path
        d="M 396,186 C 390,194 378,198 370,204 C 380,206 400,206 400,206 C 400,206 420,206 430,204 C 422,198 410,194 404,186"
        stroke-width="1.4"
      />
      <line x1="366" y1="206" x2="434" y2="206" stroke-width="1.6" />
      <line x1="364" y1="209" x2="436" y2="209" stroke-width="1.2" />
      <path d="M 370,204 C 380,201 390,204 400,201 C 410,204 420,201 430,204" stroke-width="0.8" />
    </g>

    <!-- CELESTIAL SYMBOLISM: STAR & MOON -->
    <g id="celestial-star" transform="translate(295, 145)" stroke="currentColor" stroke-width="1.1" fill="none">
      <path d="M 0,-20 L 3.5,-6 L 18,-6 L 7,3 L 11,18 L 0,8 L -11,18 L -7,3 L -18,-6 L -3.5,-6 Z" />
      <circle cx="0" cy="0" r="4.5" stroke-width="0.8" />
      <circle cx="0" cy="0" r="2" fill="var(--color-ornament-crimson)" stroke="none" />
      <line x1="0" y1="-20" x2="0" y2="-26" stroke-width="0.8" stroke="var(--color-ornament-gold)" />
      <line x1="0" y1="20" x2="0" y2="26" stroke-width="0.8" stroke="var(--color-ornament-gold)" />
      <line x1="-20" y1="0" x2="-26" y2="0" stroke-width="0.8" stroke="var(--color-ornament-gold)" />
      <line x1="20" y1="0" x2="26" y2="0" stroke-width="0.8" stroke="var(--color-ornament-gold)" />
    </g>

    <g id="celestial-moon" transform="translate(505, 145)" stroke="currentColor" stroke-width="1.1" fill="none">
      <path d="M 0,-18 A 18,18 0 1 0 18,10 A 14,14 0 1 1 0,-18 Z" />
      <path d="M 3,-13 A 13,13 0 1 0 14,8" stroke-dasharray="2 2" stroke-width="0.6" />
      <circle cx="5" cy="-2" r="2" fill="var(--color-ornament-gold)" stroke="none" />
      <circle cx="20" cy="-14" r="1.2" fill="var(--color-ornament-gold)" stroke="none" />
    </g>

    <!-- HORIZONTAL ACANTHUS & VINE WINGS -->
    <!-- Left Wing -->
    <g id="wing-left" stroke="currentColor" fill="none">
      <path d="M 330,230 C 270,205 210,215 150,235 C 110,248 85,230 65,220" stroke-width="1.4" />
      <path d="M 230,214 C 210,185 175,185 160,205 C 150,220 165,235 180,230 C 190,225 188,212 178,214" stroke-width="1.1" />
      <path d="M 275,212 C 265,190 240,180 220,192 C 230,205 255,210 275,212 Z" stroke-width="1.1" />
      <path d="M 255,195 C 248,198 242,204 238,210" stroke-width="0.7" />
      <path d="M 185,220 C 168,195 140,195 125,215 C 140,228 165,228 185,220 Z" stroke-width="1.1" />
      <path d="M 165,206 C 158,210 152,216 148,222" stroke-width="0.7" />

      <!-- Wild Rose (Left) -->
      <g transform="translate(195, 235)" stroke-width="0.9">
        <circle cx="0" cy="0" r="3" fill="var(--color-ornament-crimson)" stroke="none" />
        <circle cx="0" cy="-5.5" r="3.2" />
        <circle cx="5.2" cy="-1.8" r="3.2" />
        <circle cx="3.2" cy="4.5" r="3.2" />
        <circle cx="-3.2" cy="4.5" r="3.2" />
        <circle cx="-5.2" cy="-1.8" r="3.2" />
      </g>

      <!-- Grape Cluster (Left) -->
      <g transform="translate(245, 228)" stroke-width="0.9">
        <circle cx="0" cy="0" r="3.5" />
        <circle cx="7" cy="0" r="3.5" />
        <circle cx="3.5" cy="6" r="3.5" />
        <circle cx="10.5" cy="6" r="3.5" />
        <circle cx="7" cy="12" r="3.5" />
        <circle cx="3.5" cy="12" r="3.5" />
        <circle cx="5.2" cy="17" r="3" />
        <path d="M 10.5,6 C 16,3 18,10 15,14 C 12,18 8,14 11,10" stroke-width="0.7" />
      </g>
    </g>

    <!-- Right Wing -->
    <g id="wing-right" stroke="currentColor" fill="none">
      <path d="M 470,230 C 530,205 590,215 650,235 C 690,248 715,230 735,220" stroke-width="1.4" />
      <path d="M 570,214 C 590,185 625,185 640,205 C 650,220 635,235 620,230 C 610,225 612,212 622,214" stroke-width="1.1" />
      <path d="M 525,212 C 535,190 560,180 580,192 C 570,205 545,210 525,212 Z" stroke-width="1.1" />
      <path d="M 545,195 C 552,198 558,204 562,210" stroke-width="0.7" />
      <path d="M 615,220 C 632,195 660,195 675,215 C 660,228 635,228 615,220 Z" stroke-width="1.1" />
      <path d="M 635,206 C 642,210 648,216 652,222" stroke-width="0.7" />

      <!-- Wild Rose (Right) -->
      <g transform="translate(605, 235)" stroke-width="0.9">
        <circle cx="0" cy="0" r="3" fill="var(--color-ornament-crimson)" stroke="none" />
        <circle cx="0" cy="-5.5" r="3.2" />
        <circle cx="5.2" cy="-1.8" r="3.2" />
        <circle cx="3.2" cy="4.5" r="3.2" />
        <circle cx="-3.2" cy="4.5" r="3.2" />
        <circle cx="-5.2" cy="-1.8" r="3.2" />
      </g>

      <!-- Grape Cluster (Right) -->
      <g transform="translate(545, 228)" stroke-width="0.9">
        <circle cx="0" cy="0" r="3.5" />
        <circle cx="7" cy="0" r="3.5" />
        <circle cx="3.5" cy="6" r="3.5" />
        <circle cx="10.5" cy="6" r="3.5" />
        <circle cx="7" cy="12" r="3.5" />
        <circle cx="3.5" cy="12" r="3.5" />
        <circle cx="5.2" cy="17" r="3" />
        <path d="M 0,6 C -5,3 -7,10 -4,14 C -1,18 3,14 0,10" stroke-width="0.7" />
      </g>
    </g>
  </svg>
</div>
