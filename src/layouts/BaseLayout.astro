---
import "@fontsource-variable/inter";
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/playfair-display/wght-italic.css";
import "@fontsource/jetbrains-mono";

import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import VhsParticles from "../components/VhsParticles.astro";
import SearchModal from "../components/SearchModal.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteTitle = "DissidentX";
const siteTagline = "In pursuit of Truth.";
const defaultDescription =
  "An independent chronicle of philosophy, theology, and the arts — cultural commentary in pursuit of Truth.";
const pageTitle = title === "Home" ? `${siteTitle} | ${siteTagline}` : `${siteTitle} | ${title}`;
const pageDescription = description ?? defaultDescription;
const canonical = new URL(Astro.url.pathname, Astro.site || "https://dissidentx.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#020202" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://dissidentx.com/images/og-image.jpg" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://dissidentx.com/images/og-image.jpg" />

    <ClientRouter />
  </head>

  <body class="min-h-screen flex flex-col bg-[var(--color-void)] text-[var(--color-ink)] selection:bg-[var(--color-crimson)] selection:text-white relative">
    <!-- Subtle Independent VHS Dust / Mote Particles -->
    <VhsParticles />

    <div class="site-wrapper flex-1 flex flex-col my-6 sm:my-10 relative z-10">
      <slot />
    </div>

    <!-- Global Terminal Search Modal (Fuzzy: Title, Tags, Content) -->
    <SearchModal />
  </body>
</html>
