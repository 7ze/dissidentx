---
import "@fontsource-variable/inter";
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/playfair-display/wght-italic.css";
import "@fontsource/jetbrains-mono";

import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import VhsParticles from "../components/VhsParticles.astro";
import Background from "../components/Background.astro";
import SearchModal from "../components/SearchModal.astro";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteTitle = "DissidentX";
const siteTagline = "In pursuit of Truth.";
const defaultDescription =
  "An independent chronicle of philosophy, theology, and the arts — cultural commentary in pursuit of Truth.";
const pageTitle = title === "Home" ? `${siteTitle} | ${siteTagline}` : `${siteTitle} | ${title}`;
const pageDescription = description ?? defaultDescription;
const canonical = new URL(Astro.url.pathname, Astro.site || "https://dissidentx.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" id="meta-theme-color" content="#020202" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Theme Initialization -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored === "light" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", theme);
          const meta = document.getElementById("meta-theme-color");
          if (meta) {
            meta.setAttribute("content", theme === "light" ? "#faf6ee" : "#020202");
          }
        } catch (_) {}
      })();

      document.addEventListener("astro:before-swap", (e) => {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored === "light" ? "light" : "dark";
          if (e.newDocument) {
            e.newDocument.documentElement.setAttribute("data-theme", theme);
          }
          document.documentElement.setAttribute("data-theme", theme);
          const meta = document.getElementById("meta-theme-color");
          if (meta) {
            meta.setAttribute("content", theme === "light" ? "#faf6ee" : "#020202");
          }
        } catch (_) {}

        // Persist dev and runtime stylesheet elements across swaps so Astro's swapHeadElements
        // does not tear them down and recreate them, eliminating the dev-mode FOUC / re-parse flash.
        if (e.newDocument) {
          const currentStyles = Array.from(document.head.querySelectorAll("style"));
          const newStyles = Array.from(e.newDocument.head.querySelectorAll("style"));

          currentStyles.forEach((style, idx) => {
            const devId = style.getAttribute("data-vite-dev-id");
            const key = devId || `style-persist-${idx}`;
            style.setAttribute("data-astro-transition-persist", key);

            const matchingNew = devId
              ? newStyles.find((s) => s.getAttribute("data-vite-dev-id") === devId)
              : newStyles[idx];
            if (matchingNew) {
              matchingNew.setAttribute("data-astro-transition-persist", key);
            }
          });
        }
      });

      document.addEventListener("astro:after-swap", () => {
        try {
          const stored = localStorage.getItem("theme");
          const theme = stored === "light" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", theme);
          const meta = document.getElementById("meta-theme-color");
          if (meta) {
            meta.setAttribute("content", theme === "light" ? "#faf6ee" : "#020202");
          }
        } catch (_) {}
      });
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://dissidentx.com/images/og-image.jpg" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://dissidentx.com/images/og-image.jpg" />

    <ClientRouter />
  </head>

  <body class="min-h-screen flex flex-col bg-[var(--color-void)] text-[var(--color-ink)] relative">
    <!-- Subtle Independent VHS Dust / Mote Particles -->
    <VhsParticles />

    <!-- Stately Christian Damask Fixed Vector Wallpaper -->
    <Background />

    <div class="site-wrapper flex-1 flex flex-col my-6 sm:my-10 relative z-10">
      <slot />
    </div>

    <!-- Global Terminal Search Modal (Fuzzy: Title, Tags, Content) -->
    <SearchModal />

    <!-- Opt-in VHS Radio Player (Persistent across View Transitions) -->
    <audio
      id="vhs-radio-player"
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      transition:persist="vhs-radio-player"
    >
      <source src="/radio/vhs-midnight-forest.opus" type="audio/ogg; codecs=opus" />
      <source src="/radio/vhs-midnight-forest.mp3" type="audio/mpeg" />
    </audio>
  </body>
</html>
