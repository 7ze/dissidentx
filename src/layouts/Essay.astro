---
import Layout from "./Layout.astro";
import { formatDate, type EssayEntry } from "../lib/essays";

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  categoryTag?: string;
  readingTime?: number;
  wordCount?: number;
  prevEssay?: EssayEntry | null;
  nextEssay?: EssayEntry | null;
}

const {
  title,
  description,
  pubDate,
  author = "DissidentX",
  tags = [],
  categoryTag = "Tract",
  readingTime,
  wordCount,
  prevEssay,
  nextEssay,
} = Astro.props;
---

<Layout title={title} description={description}>
  <!-- Scroll Reading Progress Bar -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-[2px] bg-[var(--color-crimson)] z-50 transition-[width] duration-75 ease-out w-0 pointer-events-none"
    aria-hidden="true"
  ></div>

  <article class="max-w-2xl mx-auto my-6 sm:my-10">
    <!-- Back to Essays Button -->
    <div class="mb-8 pb-3 border-b border-[var(--color-rule)] flex items-center justify-between text-xs font-mono">
      <a
        href="/essays"
        class="text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] transition-colors flex items-center gap-1.5 uppercase tracking-wider py-2 min-h-[44px] inline-flex"
      >
        <span>←</span>
        <span>Essays</span>
      </a>
      <span class="text-[var(--color-crimson)] uppercase font-medium tracking-wider">
        {categoryTag}
      </span>
    </div>

    <!-- Article Header -->
    <header class="mb-10 text-center">
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-ink-bright)] tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <div class="flex items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-[var(--color-ink-faint)] uppercase tracking-wider flex-wrap">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>·</span>
        <span>By {author}</span>
        {readingTime && (
          <>
            <span>·</span>
            <span class="text-[var(--color-ink-muted)]">{readingTime} MIN READ</span>
          </>
        )}
      </div>

      <hr class="my-8 border-[var(--color-rule)] w-24 mx-auto" />
    </header>

    <!-- Prose Content -->
    <div class="prose text-[var(--color-ink-soft)]">
      <slot />
    </div>

    <!-- Article Footer / Tags & Copy Link -->
    <footer class="mt-14 pt-6 border-t border-[var(--color-rule)] flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 items-center text-[var(--color-ink-faint)]">
          <span class="uppercase">Tags:</span>
          {tags.map((tag) => (
            <span class="text-[var(--color-ink-muted)]">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- One-Click Share / Copy Link Button -->
      <button
        type="button"
        id="copy-dispatch-link"
        class="text-[var(--color-ink-muted)] hover:text-[var(--color-crimson)] transition-colors cursor-pointer select-none py-2 px-3 min-h-[44px] border border-[var(--color-rule-light)] bg-[var(--color-surface)] text-[11px] uppercase tracking-wider flex items-center gap-1.5 ml-auto vhs-chromatic-hover"
        title="Copy dispatch link"
        aria-label="Copy dispatch link to clipboard"
      >
        <span id="copy-dispatch-icon" aria-hidden="true">⎘</span>
        <span id="copy-dispatch-text">Copy link</span>
      </button>
    </footer>

    <!-- Adjacent Dispatches Navigation -->
    {(prevEssay || nextEssay) && (
      <nav class="mt-8 pt-6 border-t border-[var(--color-rule)] grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono" aria-label="Adjacent Dispatches">
        {prevEssay ? (
          <a
            href={`/essays/${prevEssay.id}`}
            class="p-4 border border-[var(--color-rule)] bg-[var(--color-surface)] hover:border-[var(--color-rule-light)] transition-colors group flex flex-col justify-between gap-2"
          >
            <span class="text-[10px] text-[var(--color-ink-faint)] uppercase tracking-wider group-hover:text-[var(--color-crimson)] transition-colors">
              ← Previous Dispatch
            </span>
            <span class="font-serif text-sm font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-crimson)] transition-colors line-clamp-2">
              {prevEssay.data.title}
            </span>
          </a>
        ) : <div class="hidden sm:block"></div>}

        {nextEssay ? (
          <a
            href={`/essays/${nextEssay.id}`}
            class="p-4 border border-[var(--color-rule)] bg-[var(--color-surface)] hover:border-[var(--color-rule-light)] transition-colors group flex flex-col justify-between gap-2 text-left sm:text-right"
          >
            <span class="text-[10px] text-[var(--color-ink-faint)] uppercase tracking-wider group-hover:text-[var(--color-crimson)] transition-colors">
              Next Dispatch →
            </span>
            <span class="font-serif text-sm font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-crimson)] transition-colors line-clamp-2">
              {nextEssay.data.title}
            </span>
          </a>
        ) : null}
      </nav>
    )}
  </article>
</Layout>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById("reading-progress-bar");
    if (!bar) return;

    const update = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - window.innerHeight;
      if (height <= 0) {
        bar.style.width = "0%";
        return;
      }
      const percent = Math.min(100, Math.max(0, (scrollY / height) * 100));
      bar.style.width = `${percent}%`;
    };

    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  function setupCopyLink() {
    const copyBtn = document.getElementById("copy-dispatch-link");
    const copyText = document.getElementById("copy-dispatch-text");
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyText) copyText.textContent = "COPIED ✓";
        copyBtn.classList.add("text-[var(--color-vhs-green)]", "border-[var(--color-vhs-green)]");
        setTimeout(() => {
          if (copyText) copyText.textContent = "Copy link";
          copyBtn.classList.remove("text-[var(--color-vhs-green)]", "border-[var(--color-vhs-green)]");
        }, 2000);
      } catch (err) {
        console.error("Failed to copy dispatch link:", err);
      }
    });
  }

  setupReadingProgress();
  setupCopyLink();
  document.addEventListener("astro:page-load", () => {
    setupReadingProgress();
    setupCopyLink();
  });
</script>
