---
import Layout from "../layouts/Layout.astro";

const pageTitle = "404 // Lost in the Ruins";
const pageDescription = "This page could not be found. Return to the sanctuary.";
---

<Layout title={pageTitle} description={pageDescription} codex="CODEX 00">
  <div class="max-w-md mx-auto my-12 text-center">
    <div class="border border-[var(--color-rule-light)] bg-[var(--color-surface)] p-8">
      <div class="text-[var(--color-crimson)] font-mono text-xs uppercase tracking-widest mb-2">
        [ VOID ENCOUNTERED ]
      </div>
      <h1 class="font-serif text-5xl font-extrabold text-white mb-4">
        404
      </h1>
      <p class="font-serif italic text-sm text-[var(--color-ink-muted)] mb-6">
        This path leads to desolate sands. No tract or dispatch exists at this location.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center border border-[var(--color-rule-light)] bg-black px-5 py-2.5 min-h-[44px] font-mono text-xs text-white hover:border-[var(--color-crimson)] transition-colors uppercase tracking-wider vhs-chromatic-hover"
      >
        [ ← RETURN TO SANCTUARY ]
      </a>
    </div>
  </div>
</Layout>
