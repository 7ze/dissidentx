---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Libertas";
const pageDescription =
	"DissidentX: A platform for bold minds, defying conformity, and uncovering uncensored truths in history, culture, and liberty. Join the vigil at dissidentx.com.";
---

<Layout title={pageTitle} , description={pageDescription}>
	<div class="grid place-items-center min-h-[80vh]">
		<div class="prose mx-auto text-center text-white/50">
			<div class="font-display font-black text-3xl text-white/60">
				<p>
					Uncensored. Unafraid. Unstoppable.
					<br />
					Join the <span class="italic text-cyan-700">Resistance</span
					> today.
				</p>
			</div>
			<p class="font-display font-light italic text-xl mt-10">
				"The Price of Liberty is Eternal Vigilance."
			</p>
		</div>
	</div>
</Layout>
