---
import Layout from "../layouts/Layout.astro";
import FeaturedEssay from "../components/FeaturedEssay.astro";
import CollectionsIndex from "../components/CollectionsIndex.astro";
import { getEssays } from "../lib/essays";

const pageTitle = "Home";
const pageDescription =
  "DissidentX — In pursuit of Truth. A layman's chronicle in philosophy, theology, and monastic praxis.";

const allEssays = await getEssays();
// Find featured essay or fallback to latest
const featuredEssay = allEssays.find((e) => e.data.isFeatured) || allEssays[0];
// Remaining essays for the collections index
const otherEssays = allEssays.filter((e) => e.id !== featuredEssay?.id);
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-2xl mx-auto flex flex-col gap-6 sm:gap-8 my-6 sm:my-8">
    {featuredEssay && (
      <FeaturedEssay essay={featuredEssay} />
    )}

    <CollectionsIndex essays={otherEssays} />
  </div>
</Layout>
