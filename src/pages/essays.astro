---
import Layout from "../layouts/Layout.astro";
import EssayList from "../components/EssayList.astro";
import { getEssays } from "../lib/essays";

const pageTitle = "Essays & Tracts";
const pageDescription =
  "An independent chronicle of philosophy, theology, and the arts — cultural commentary in pursuit of Truth.";
const essays = await getEssays();
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-2xl mx-auto my-6 sm:my-10">
    <!-- Header -->
    <header class="border-b border-[var(--color-rule)] pb-6 mb-8">
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight">
        Essays & Tracts
      </h1>
      <p class="font-serif font-light italic text-xl sm:text-2xl text-[var(--color-ink-muted)] mt-2">
        An independent chronicle of philosophy, theology, and the arts — cultural commentary in pursuit of Truth
      </p>
    </header>

    <!-- Dispatches Table -->
    <EssayList essays={essays} />
  </div>
</Layout>
