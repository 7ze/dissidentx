---
import Layout from "../layouts/Layout.astro";
const pageTitle = "Essays";
---

<Layout title={pageTitle}>
	<div class="grid place-items-center min-h-[80vh]">
		<div class="mx-auto px-4 prose text-white/60 text-center">
			<h1 class="font-display">Essays</h1>
			<p class="text-justify">
				This is my very own unapologetic, brutally honest writing space,
				where I write about things that matter to me, among other
				things. Keep tuned in for more; More essays and content to be
				published soon!
			</p>
			<ul class="text-center list-none font-display text-lg pl-0">
				<li>
					<a href="/essays/01-why-dissidentx">Why DissidentX?</a>
				</li>
			</ul>
			<p class="mt-20 text-white/40 italic font-light">
				More to be published soon... Stay Tuned!
			</p>
		</div>
	</div>
</Layout>
