---
import Layout from "../layouts/Layout.astro";
const pageTitle = "Essays";
const pageDescription = "List of published essays here on DissidentX";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="grid place-items-center min-h-[80vh]">
		<div class="mx-auto px-4 prose text-white/60 text-center">
			<h1 class="font-display">Essays</h1>
			<p class="text-justify">
				A space for personal reflections born from ongoing study and
				inquiry. These writings invite fellow seekers to join in
				exploring questions that shape understanding and character. More
				to come.
			</p>
			<ul class="text-center list-none font-display text-lg pl-0">
				<li>
					<a href="/essays/01-why-dissidentx">Why DissidentX?</a>
				</li>
			</ul>
			<p class="mt-20 text-white/40 italic font-light">
				More to be published soon... Stay Tuned!
			</p>
		</div>
	</div>
</Layout>
